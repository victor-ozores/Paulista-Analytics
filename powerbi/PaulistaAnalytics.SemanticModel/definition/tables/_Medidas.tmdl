/// Medidas DAX do dashboard, em pastas numeradas. Sem dados. Cada medida tem descrição; definições em docs/medidas_dax.md.
table _Medidas
	lineageTag: e4007454-ca24-400d-8aa4-c4c1144cc5cb

	/// I01. Quantos jogos. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Jogos = COUNTROWS(fato_partida)
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: 33d58c08-0e14-4c5f-9cc8-062b8fe17759

	/// I02. Gols do placar (inclui pênalti, falta e gol contra; sem a disputa de pênaltis). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Gols = SUM(fato_partida[gols_mandante]) + SUM(fato_partida[gols_visitante])
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: c9c0ca04-9578-4afe-acbc-4dbea982df82

	/// I03. Média de gols por jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número com 2 casas decimais. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols por jogo' = DIVIDE([Gols], [Jogos])
		formatString: #,0.00
		displayFolder: 01 Resultados
		lineageTag: 0523eba6-ffdc-4452-9946-3669f3a6ff32

	/// I04. Jogos em que o mandante fez mais gols no tempo regulamentar. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Vitórias do mandante' = COUNTROWS(FILTER(fato_partida, fato_partida[gols_mandante] > fato_partida[gols_visitante])) + 0
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: 1b2ede09-cfcd-4d41-b2a6-ec88f84d8995

	/// I05. Jogos empatados no tempo regulamentar (o decidido nos pênaltis conta como empate). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Empates = COUNTROWS(FILTER(fato_partida, fato_partida[gols_mandante] = fato_partida[gols_visitante])) + 0
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: 2943612c-c334-42ad-ad08-ae63d782a077

	/// I06. Jogos em que o visitante fez mais gols no tempo regulamentar. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Vitórias do visitante' = COUNTROWS(FILTER(fato_partida, fato_partida[gols_mandante] < fato_partida[gols_visitante])) + 0
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: 8842a953-8811-421e-9874-110c3f631f90

	/// I07. Vitórias do mandante sobre o total de jogos. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% vitórias do mandante' = DIVIDE([Vitórias do mandante], [Jogos])
		formatString: 0.0%
		displayFolder: 01 Resultados
		lineageTag: 9a9a614e-4dc5-478d-8a3d-b50d88647940

	/// I08. Empates sobre o total de jogos. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% empates' = DIVIDE([Empates], [Jogos])
		formatString: 0.0%
		displayFolder: 01 Resultados
		lineageTag: c3f155d3-2eda-43ac-86ee-22a7b7c16454

	/// I09. Vitórias do visitante sobre o total de jogos. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% vitórias do visitante' = DIVIDE([Vitórias do visitante], [Jogos])
		formatString: 0.0%
		displayFolder: 01 Resultados
		lineageTag: 1279819a-b907-4285-94ba-c126ed55c92f

	/// I26. Jogos 0 x 0. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Jogos sem gols' = COUNTROWS(FILTER(fato_partida, fato_partida[gols_mandante] + fato_partida[gols_visitante] = 0)) + 0
		formatString: #,0
		displayFolder: 01 Resultados
		lineageTag: b1729a65-a9fd-434b-9a9a-03a67b30efc0

	/// I25. Gols de pênalti durante o jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols de pênalti' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] = "gol_penalti") + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo
		lineageTag: c84107c1-39be-4e0a-be66-30b0b5e87b35

	/// I23. Minutos de acréscimo por jogo (1º mais 2º tempo), pela súmula. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número com 2 casas decimais. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Acréscimo médio (min)' = AVERAGEX(fato_partida, fato_partida[acrescimo_1t_min] + fato_partida[acrescimo_2t_min])
		formatString: #,0.00
		displayFolder: 02 Gols e tempo
		lineageTag: 5e171f86-eaff-456e-90f4-b2db1ffe8402

	/// I24. Gols entre os minutos 01-15 (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 01-15' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 0, fato_evento[minuto] <= 15) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: 56e067fb-30a8-46b7-ba3d-3f895a203ab5

	/// I24. Gols entre os minutos 16-30 (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 16-30' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 16, fato_evento[minuto] <= 30) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: 532464ee-6e52-4b1c-87fa-ef779f52c968

	/// I24. Gols entre os minutos 31-45 (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 31-45' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 31, fato_evento[minuto] <= 45) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: 7f956fb2-719f-49c0-a968-a4ef3bf8385f

	/// I24. Gols entre os minutos 46-60 (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 46-60' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 46, fato_evento[minuto] <= 60) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: b4b95f2c-9231-4d09-904f-c185527df215

	/// I24. Gols entre os minutos 61-75 (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 61-75' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 61, fato_evento[minuto] <= 75) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: be78ada4-a010-4000-8bfe-00917fbc60c4

	/// I24. Gols entre os minutos 76-90+ (o acréscimo fica na última faixa do tempo). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols 76-90+' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta", "gol_contra"}, fato_evento[minuto] >= 76, fato_evento[minuto] <= 999) + 0
		formatString: #,0
		displayFolder: 02 Gols e tempo\Faixas de minuto
		lineageTag: 862a8d6f-26b9-4142-8468-a3dcd4eca533

	/// I10. Ingressos vendidos (boletim financeiro). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Público total' = SUM(fato_partida[publico_boletim])
		formatString: #,0
		displayFolder: 03 Público e renda
		lineageTag: 219da47f-1198-4090-9e86-94801eac08cd

	/// I11. Público médio por jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número com 2 casas decimais. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Público médio' = DIVIDE([Público total], [Jogos])
		formatString: #,0.00
		displayFolder: 03 Público e renda
		lineageTag: a516404c-680f-42ee-96c3-e0e17e0dacee

	/// I12. Maior público de um jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Maior público' = MAX(fato_partida[publico_boletim])
		formatString: #,0
		displayFolder: 03 Público e renda
		lineageTag: 5e5a1634-0de6-48eb-ae6d-8870b63f2df9

	/// I13. Menor público de um jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Menor público' = MIN(fato_partida[publico_boletim])
		formatString: #,0
		displayFolder: 03 Público e renda
		lineageTag: 9ef558f5-b46e-45e4-8a88-6c874871fc90

	/// I14. Pessoas que pagaram ingresso. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Público pagante' = SUM(fato_partida[publico_pagante])
		formatString: #,0
		displayFolder: 03 Público e renda
		lineageTag: 746b41d8-cf9f-4401-850b-496d819ca7dd

	/// I15. Parte do público que pagou. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% de pagantes' = DIVIDE([Público pagante], [Público total])
		formatString: 0.0%
		displayFolder: 03 Público e renda
		lineageTag: 49b0c23d-3f59-469f-93cc-cfc9cbff7bc2

	/// I16. Arrecadação de ingressos antes das despesas. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Renda bruta' = SUM(fato_partida[renda_bruta])
		formatString: "R$" #,0.00
		displayFolder: 03 Público e renda
		lineageTag: 16c7ffd8-a82f-42de-be08-1b844c1e6845

	/// I17. Renda bruta menos as despesas do jogo (pode ser negativa). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Renda líquida' = SUM(fato_partida[renda_liquida])
		formatString: "R$" #,0.00
		displayFolder: 03 Público e renda
		lineageTag: a66a2eae-e37d-461a-a831-a11d6fb849b0

	/// I18. Renda bruta dividida pelo público pagante. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Ticket médio' = DIVIDE([Renda bruta], [Público pagante])
		formatString: "R$" #,0.00
		displayFolder: 03 Público e renda
		lineageTag: 4c6af77f-3a8c-4c0b-bfca-371dcc754adb

	/// I19. Jogos em que as despesas passaram da arrecadação. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Jogos com renda líquida negativa' = COUNTROWS(FILTER(fato_partida, fato_partida[renda_liquida] < 0)) + 0
		formatString: #,0
		displayFolder: 03 Público e renda
		lineageTag: c58ac0de-727e-44c1-a03b-9c7be277f9dd

	/// I20. Regra da FPF: todas as advertências (atletas e comissão) menos os segundos amarelos. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Amarelos = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] = "amarelo") - CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] = "segundo_amarelo") + 0
		formatString: #,0
		displayFolder: 04 Disciplina
		lineageTag: b08af6b4-2a5e-4ad9-b0f6-e5884ff56814

	/// I21. Regra da FPF: vermelhos diretos mais as expulsões por segundo amarelo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Vermelhos = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] = "vermelho") + CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] = "segundo_amarelo") + 0
		formatString: #,0
		displayFolder: 04 Disciplina
		lineageTag: 723ebd88-c61c-47b6-86e3-998ca9205f3f

	/// I22. Amarelos mais vermelhos por jogo. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Formato: número com 2 casas decimais. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Cartões por jogo' = DIVIDE([Amarelos] + [Vermelhos], [Jogos])
		formatString: #,0.00
		displayFolder: 04 Disciplina
		lineageTag: 654de1a2-638c-4604-a4fd-6f03f75d0c08

	/// I01. Jogos do clube selecionado, como mandante ou visitante. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Jogos do clube' = CALCULATE(COUNTROWS(fato_partida), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube])) + CALCULATE(COUNTROWS(fato_partida), USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 05 Clube
		lineageTag: c6cfe17a-efca-4219-9501-20f4b54b8eb1

	/// I27. Gols que o clube fez. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols pró' = CALCULATE(SUM(fato_partida[gols_mandante]), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube])) + CALCULATE(SUM(fato_partida[gols_visitante]), USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 05 Clube
		lineageTag: 33bf77c1-40bd-4735-91f7-217f9f0fa030

	/// I28. Gols que o clube levou. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols contra' = CALCULATE(SUM(fato_partida[gols_visitante]), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube])) + CALCULATE(SUM(fato_partida[gols_mandante]), USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 05 Clube
		lineageTag: 5ca9a23c-cf09-4672-a34a-8a8016ca39e9

	/// Pontos do clube nos jogos do contexto (3 por vitória, 1 por empate no tempo regulamentar). Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure Pontos = CALCULATE(SUMX(fato_partida, SWITCH(TRUE(), fato_partida[gols_mandante] > fato_partida[gols_visitante], 3, fato_partida[gols_mandante] = fato_partida[gols_visitante], 1, 0)), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube])) + CALCULATE(SUMX(fato_partida, SWITCH(TRUE(), fato_partida[gols_visitante] > fato_partida[gols_mandante], 3, fato_partida[gols_mandante] = fato_partida[gols_visitante], 1, 0)), USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 05 Clube
		lineageTag: 47a34cab-879c-410e-b2ef-ce03e624eca3

	/// I29. Pontos do clube na primeira fase. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Pontos 1ª fase' = CALCULATE([Pontos], dim_fase[nome_fase] = "PRIMEIRA FASE")
		formatString: #,0
		displayFolder: 05 Clube
		lineageTag: d2cd60c9-c02c-4631-b2dd-423b124833de

	/// I30. Pontos conquistados sobre os disputados na primeira fase. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Aproveitamento 1ª fase' = DIVIDE([Pontos 1ª fase], 3 * CALCULATE([Jogos do clube], dim_fase[nome_fase] = "PRIMEIRA FASE"))
		formatString: 0.0%
		displayFolder: 05 Clube
		lineageTag: 4b290a53-c46c-49a4-8d87-8d3e2abfd12f

	/// I32. Público médio dos jogos em que o clube foi mandante. Medida de clube: soma o clube como mandante e como visitante (USERELATIONSHIP). Sem clube selecionado, soma todos os clubes. Formato: número com 2 casas decimais. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Público médio como mandante' = CALCULATE(AVERAGE(fato_partida[publico_boletim]), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube]))
		formatString: #,0.00
		displayFolder: 05 Clube
		lineageTag: d783619c-8a64-4b4f-af7c-9f9c247a67f8

	/// Vitórias do clube na primeira fase. Apoio da classificação da 1ª fase pelo Art. 16, por clube. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Vitórias 1ª fase' = CALCULATE(COUNTROWS(FILTER(fato_partida, fato_partida[gols_mandante] > fato_partida[gols_visitante])), USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube]), dim_fase[nome_fase] = "PRIMEIRA FASE") + CALCULATE(COUNTROWS(FILTER(fato_partida, fato_partida[gols_visitante] > fato_partida[gols_mandante])), USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]), dim_fase[nome_fase] = "PRIMEIRA FASE") + 0
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: e90cfc69-7537-4349-99a5-ff054ec9c001

	/// Gols marcados na primeira fase. Apoio da classificação da 1ª fase pelo Art. 16, por clube. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Gols pró 1ª fase' = CALCULATE([Gols pró], dim_fase[nome_fase] = "PRIMEIRA FASE")
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: 59642091-6a11-47fc-ae7b-a7dd897385be

	/// Saldo de gols na primeira fase. Apoio da classificação da 1ª fase pelo Art. 16, por clube. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Saldo 1ª fase' = [Gols pró 1ª fase] - CALCULATE([Gols contra], dim_fase[nome_fase] = "PRIMEIRA FASE")
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: e136d3d3-37f4-41d2-8767-9567ea5369e5

	/// Amarelos do clube na primeira fase (regra da FPF). Apoio da classificação da 1ª fase pelo Art. 16, por clube. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Amarelos 1ª fase' = CALCULATE([Amarelos], dim_fase[nome_fase] = "PRIMEIRA FASE")
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: b4576245-ce4f-489f-8fa3-fc5e3f4a4530

	/// Vermelhos do clube na primeira fase (regra da FPF). Apoio da classificação da 1ª fase pelo Art. 16, por clube. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Vermelhos 1ª fase' = CALCULATE([Vermelhos], dim_fase[nome_fase] = "PRIMEIRA FASE")
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: 546ef508-89a0-42a0-9e35-c30822df7301

	/// Número que ordena a primeira fase pelo Art. 16: pontos, vitórias, saldo, gols marcados, menos vermelhos, menos amarelos (cada critério numa casa própria; maior é melhor). Apoio da classificação da 1ª fase pelo Art. 16. Só faz sentido com um clube selecionado (compara os 16 clubes). Formato: chave de ordenação, sem unidade. Medida de apoio da classificação, conferida contra a tabela oficial da FPF (16 de 16 clubes).
	measure 'Chave Art. 16' = [Pontos 1ª fase] * 10^12 + [Vitórias 1ª fase] * 10^10 + ([Saldo 1ª fase] + 100) * 10^7 + [Gols pró 1ª fase] * 10^5 + (99 - [Vermelhos 1ª fase]) * 10^3 + (999 - [Amarelos 1ª fase])
		formatString: 0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: b08daa29-6ec7-45d8-ab5c-cffed565476c

	/// I31. Posição do clube na primeira fase pelo desempate do Art. 16. Apoio da classificação da 1ª fase pelo Art. 16. Só faz sentido com um clube selecionado (compara os 16 clubes). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Posição 1ª fase' = RANKX(ALL(dim_clube), [Chave Art. 16], , DESC, SKIP)
		formatString: #,0
		displayFolder: 06 Classificação (Art. 16)
		lineageTag: 6d007660-13fc-451c-a8aa-5297d28bd5bc

	/// I33. Gols do atleta pelo próprio clube (gol de pênalti e de falta contam; gol contra não). Filtre por atleta e clube; sem filtro, soma os gols de todos os atletas. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Gols do atleta' = CALCULATE(COUNTROWS(fato_evento), fato_evento[tipo_evento] IN {"gol", "gol_penalti", "gol_falta"}) + 0
		formatString: #,0
		displayFolder: 07 Artilharia
		lineageTag: 28e268c1-e182-4af8-a7d5-7893b7622eba

	/// I34. Regras de conferência que rodaram. Qualidade dos dados: não depende dos filtros de jogo. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Regras executadas' = COUNTROWS(resultado_regra)
		formatString: #,0
		displayFolder: 08 Qualidade dos dados
		lineageTag: 8db50a72-380d-45f6-bdcf-28d0169eda9c

	/// I35. Regras em que as fontes concordam por completo. Qualidade dos dados: não depende dos filtros de jogo. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Regras sem ocorrência' = COUNTROWS(FILTER(resultado_regra, resultado_regra[resultado] = "ok")) + 0
		formatString: #,0
		displayFolder: 08 Qualidade dos dados
		lineageTag: 4d272934-4a88-4afc-b908-826b468b3f8b

	/// I36. Divergências ainda sem solução. Qualidade dos dados: não depende dos filtros de jogo. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Inconsistências abertas' = CALCULATE(COUNTROWS(fato_inconsistencia), fato_inconsistencia[status] = "aberta") + 0
		formatString: #,0
		displayFolder: 08 Qualidade dos dados
		lineageTag: c10f0baf-5598-4e4c-9eb2-767432b08889

	/// I37. Divergências com causa conhecida e decisão registrada (explicadas, aceitas ou corrigidas). Qualidade dos dados: não depende dos filtros de jogo. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Inconsistências explicadas' = CALCULATE(COUNTROWS(fato_inconsistencia), fato_inconsistencia[status] IN {"explicada", "aceita", "corrigida"}) + 0
		formatString: #,0
		displayFolder: 08 Qualidade dos dados
		lineageTag: 1e60e55e-753b-4b48-b8a1-7b41e8b8751d

	/// I38. Despesas dos jogos: soma das rubricas dos blocos B1, B2 e B3 do boletim. Com um grupo de despesa ou um bloco filtrado, só o que é dele. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Despesas = SUM(fato_despesa[valor])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: 4ed4c1e7-41dd-5e53-a088-d48c0e9e0c3d

	/// I39. Quanto da arrecadação foi gasto em despesas. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% despesas sobre renda bruta' = DIVIDE([Despesas], [Renda bruta])
		formatString: 0.0%
		displayFolder: 09 Financeiro
		lineageTag: 384d5548-8b4b-5671-8151-1c0cdb22a2e7

	/// I40. Despesa média por ingresso vendido. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Despesa por ingresso' = DIVIDE([Despesas], [Público total])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: f03dbe57-ce74-51fb-bc01-f002d0f9ebc8

	/// I41. Ingressos vendidos em setores cujo nome cita visitante (estimativa pelo nome do setor). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Ingressos em setor de visitante' = CALCULATE(SUM(fato_ingresso[ingressos]), fato_ingresso[setor_visitante] = 1) + 0
		formatString: #,0
		displayFolder: 09 Financeiro
		lineageTag: 49312042-77ad-5f19-9a5b-c6b724f7d08b

	/// I42. Parte do público que está em setor de visitante. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% torcida visitante' = DIVIDE([Ingressos em setor de visitante], [Público total])
		formatString: 0.0%
		displayFolder: 09 Financeiro
		lineageTag: 8d3afd2f-23b7-5701-889d-66a8d9ef4e1c

	/// I43. Descontos que o boletim aplica sobre a parte de cada clube na divisão da renda líquida (INSS e outras). Responde aos filtros de fase, calendário, estádio, árbitro e clube (a divisão da renda tem uma linha por clube em cada jogo). Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Deduções = SUM(fato_rateio[deducao_inss]) + SUM(fato_rateio[deducao_outras])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: acd1e63e-67ee-5fac-8bb8-8c0ad81de699

	/// I44. O que o clube recebe da renda líquida depois das deduções (em 2026 o mandante fica com 100% e o visitante com 0%). Responde aos filtros de fase, calendário, estádio, árbitro e clube (a divisão da renda tem uma linha por clube em cada jogo). Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Líquido a receber' = SUM(fato_rateio[liquido])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: 31e61944-2c10-5231-a83e-fc83e3bc5951

	/// I45. Ingressos vendidos, somando as linhas do boletim; com uma categoria filtrada, os dela. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Ingressos vendidos' = SUM(fato_ingresso[ingressos])
		formatString: #,0
		displayFolder: 09 Financeiro
		lineageTag: 3771329f-74d2-5e0a-b9eb-a54a59807e8f

	/// I46. Dinheiro arrecadado pelas linhas de ingresso; com uma categoria filtrada, o dela. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Arrecadação dos ingressos' = SUM(fato_ingresso[arrecadacao])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: f1bf9e41-d90e-54f5-bc9c-7415eb0bd3ee

	/// I47. Quanto cada ingresso rendeu, em média (a gratuidade por lei não tem preço: zero). Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Preço médio por ingresso' = DIVIDE([Arrecadação dos ingressos], [Ingressos vendidos])
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro
		lineageTag: e58b9ab7-2c82-5194-b029-41718868a02c

	/// I48. Parte dos ingressos vendidos que é da categoria filtrada. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% dos ingressos' = DIVIDE([Ingressos vendidos], CALCULATE([Ingressos vendidos], ALL(fato_ingresso[categoria])))
		formatString: 0.0%
		displayFolder: 09 Financeiro
		lineageTag: f9433c32-b3a2-543b-bdbb-eb18aa910059

	/// I49. Parte da arrecadação que é da categoria filtrada. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% da arrecadação' = DIVIDE([Arrecadação dos ingressos], CALCULATE([Arrecadação dos ingressos], ALL(fato_ingresso[categoria])))
		formatString: 0.0%
		displayFolder: 09 Financeiro
		lineageTag: 5ce312fa-0698-5c87-a2b7-fc4dfb86f1c9

	/// I50. Parte das despesas que é do grupo de despesa ou do bloco filtrado. Responde aos filtros de fase, calendário, estádio e árbitro; com um clube filtrado não filtra a partida (para um clube use a pasta 05). Financeiro: o filtro chega aos ingressos e às despesas pelo jogo; os filtros de categoria de ingresso, grupo de despesa e bloco valem para as medidas que usam essas tabelas. Formato: porcentagem. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure '% das despesas' = DIVIDE([Despesas], CALCULATE([Despesas], ALL(fato_despesa[grupo]), ALL(fato_despesa[bloco_codigo])))
		formatString: 0.0%
		displayFolder: 09 Financeiro
		lineageTag: 81ebb123-a8fe-5c42-b023-cb9d1249b68d

	/// I51. Arrecadação dos jogos em que o clube foi mandante (a renda do jogo é do mandante). Medida de clube: usa USERELATIONSHIP na partida (como mandante ou como visitante) e o filtro segue da partida para os ingressos. Sem clube selecionado, soma todos os clubes. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Renda bruta como mandante' = CALCULATE([Renda bruta], USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube]))
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro\Clube
		lineageTag: 73ebef48-151c-5918-b150-a409ecf8fd62

	/// I52. Renda líquida dos jogos em que o clube foi mandante (pode ser negativa). Medida de clube: usa USERELATIONSHIP na partida (como mandante ou como visitante) e o filtro segue da partida para os ingressos. Sem clube selecionado, soma todos os clubes. Formato: reais (R$). Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Renda líquida como mandante' = CALCULATE([Renda líquida], USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube]))
		formatString: "R$" #,0.00
		displayFolder: 09 Financeiro\Clube
		lineageTag: ca3ac277-942f-5fa7-a5b0-865bc9d47e36

	/// I53. Ingressos em setor de visitante vendidos nos jogos em que o clube foi mandante (a torcida adversária no estádio dele). Medida de clube: usa USERELATIONSHIP na partida (como mandante ou como visitante) e o filtro segue da partida para os ingressos. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Torcida visitante recebida' = CALCULATE([Ingressos em setor de visitante], USERELATIONSHIP(fato_partida[id_clube_mandante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 09 Financeiro\Clube
		lineageTag: c41fe6ce-d7c8-5d34-9521-e2de67f7fc1d

	/// I54. Ingressos em setor de visitante vendidos nos jogos em que o clube foi visitante (a torcida que ele levou). Medida de clube: usa USERELATIONSHIP na partida (como mandante ou como visitante) e o filtro segue da partida para os ingressos. Sem clube selecionado, soma todos os clubes. Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Torcida visitante levada' = CALCULATE([Ingressos em setor de visitante], USERELATIONSHIP(fato_partida[id_clube_visitante], dim_clube[id_clube]))
		formatString: #,0
		displayFolder: 09 Financeiro\Clube
		lineageTag: bb42997c-7a32-5fd1-8cc8-758f66e1a5cc

	/// I55. Atletas-jogo em que o atleta entrou em campo (titular ou reserva que entrou). Responde aos filtros de fase, calendário, estádio, árbitro e clube (cada linha da relação de jogadores e das substituições tem o clube dela). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Atletas em campo' = COUNTROWS(FILTER(fato_escalacao, fato_escalacao[jogou] = 1)) + 0
		formatString: #,0
		displayFolder: 10 Elenco
		lineageTag: 072046e2-326c-5bc9-af62-f0d434c7a775

	/// I56. Titulares escalados (11 por time em cada jogo). Responde aos filtros de fase, calendário, estádio, árbitro e clube (cada linha da relação de jogadores e das substituições tem o clube dela). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure Titulares = COUNTROWS(FILTER(fato_escalacao, fato_escalacao[situacao] = "titular")) + 0
		formatString: #,0
		displayFolder: 10 Elenco
		lineageTag: 4a9387a0-3b2f-5593-bf4e-780d5c1b5b8c

	/// I57. Reservas que entraram em campo. Responde aos filtros de fase, calendário, estádio, árbitro e clube (cada linha da relação de jogadores e das substituições tem o clube dela). Formato: número inteiro. Conferida linha a linha contra o gabarito em Python (ref_indicadores).
	measure 'Reservas que entraram' = COUNTROWS(FILTER(fato_escalacao, fato_escalacao[situacao] = "reserva" && fato_escalacao[jogou] = 1)) + 0
		formatString: #,0
