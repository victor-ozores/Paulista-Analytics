 (aba Estatísticas) são da ESPN, não oficiais. Eles foram conferidos com os placares, os indicadores e o cadastro de árbitros.',linhasTip([['Jogos',num(D.jogos.length)],['Relacionados',num(D.esc.reduce(function(s,e){return s+e[0].length+e[1].length},0))],['Trocas',num(D.sub.reduce(function(s,e){return s+e.length},0))]]))+'>Dados: súmulas oficiais da FPF · <b>escalações conferidas com as súmulas</b> · estatísticas: ESPN, não oficial</span><span>Projeto independente, sem vínculo com a FPF · escudos são marcas dos clubes</span>';~~NL~~}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>À esquerda, a lista dos jogos: filtre por <b>rodada</b>, <b>clube</b> (escudos) e <b>resultado</b> e clique em um jogo. As setas para cima e para baixo do teclado passam de um jogo para o outro.</li><li>Em cima, a ficha: placar, rodada, data, estádio e árbitro. A <b>linha do jogo</b> mostra gols, cartões e trocas nos minutos (mandante em cima, visitante embaixo).</li><li>Embaixo, as <b>escalações</b> (titulares e banco), os <b>lances</b> (gols e cartões em ordem) e, nas abas, público e renda, arbitragem e estatísticas.</li><li>Os botões de fase também filtram a lista. <b>Limpar</b> ou a tecla Esc soltam os filtros (resultado, clube, rodada e, por último, a fase).</li></ol></div><div><h3>Palavras que aparecem</h3><dl><dt>Titular e banco</dt><dd>A súmula traz os 11 titulares e os reservas de cada time, sem posição em campo nem formação.</dd><dt>Troca</dt><dd>Seta para baixo é a saída e seta para cima é a entrada, com o minuto; ""int."" é troca no intervalo. A troca por concussão fica marcada na dica.</dd><dt>Cartões</dt><dd>Pela regra da FPF: o primeiro amarelo de quem foi expulso por segundo amarelo não conta; a expulsão conta como vermelho.</dd><dt>ESPN, não oficial</dt><dd>As estatísticas dos times vêm da ESPN, não da súmula da FPF.</dd></dl></div><div class=""fe""><button data-act=""ajuda-fechar""'+tp('Fechar','Fecha este passo a passo. Também fecham as teclas Esc, Enter e espaço, ou um clique fora da janela.')+'>Entendi</button></div></div>';~~NL~~}~~NL~~function ajuda(abrir){~~NL~~if(abrir===undefined)abrir=!ajEl.classList.contains('on');~~NL~~if(abrir)esconderTip();~~NL~~ajEl.classList.toggle('on',abrir);~~NL~~}~~NL~~function marcarRolagem(e){var w=e.parentNode;if(w&&w.classList)w.classList.toggle('mais',e.scrollHeight-e.scrollTop-e.clientHeight>2)}~~NL~~function ajustarRolagem(){var l=raiz.querySelectorAll('.rola');for(var i=0;i<l.length;i++)marcarRolagem(l[i])}~~NL~~function ajustarLista(salvo){~~NL~~var rl=raiz.querySelector('.p1 .rola'),l=lista(),k=0;~~NL~~for(var i=0;i<l.length;i++)if(l[i].n===est.jogo)k=i;~~NL~~var topo=salvo;~~NL~~if(k*ROW<topo)topo=k*ROW;~~NL~~if((k+1)*ROW>topo+LISTA_H)topo=(k+1)*ROW-LISTA_H;~~NL~~if(topo<0)topo=0;~~NL~~rl.scrollTop=topo;~~NL~~}~~NL~~function atualizar(){~~NL~~esconderTip();~~NL~~var rl=raiz.querySelector('.p1 .rola'),salvo=rl&&typeof rl.scrollTop==='number'?rl.scrollTop:0;~~NL~~controles();cabecalho();~~NL~~EL.p1.innerHTML=bloco1();~~NL~~ajustarLista(salvo);~~NL~~EL.p2.innerHTML=bloco2();~~NL~~EL.p3.innerHTML=bloco3();~~NL~~EL.p4.innerHTML=bloco4();~~NL~~EL.p5.innerHTML=bloco5();~~NL~~EL.p6.innerHTML=bloco6();~~NL~~ajustarRolagem();~~NL~~}~~NL~~function ajustar(){~~NL~~var w=raiz.clientWidth,h=raiz.clientHeight;if(!w||!h)return;~~NL~~var k=Math.min(w/1920,h/1024);~~NL~~est.k=k;est.ox=Math.round((w-1920*k)/2);est.oy=Math.round((h-1024*k)/2);~~NL~~palco.style.transform='translate('+est.ox+'px,'+est.oy+'px) scale('+k+')';~~NL~~}~~NL~~window.addEventListener('resize',ajustar);~~NL~~if(window.ResizeObserver)new ResizeObserver(ajustar).observe(raiz);~~NL~~ajustar();setTimeout(ajustar,60);setTimeout(ajustar,400);~~NL~~function pontoPalco(ev){var r=raiz.getBoundingClientRect();return[(ev.clientX-r.left-est.ox)/est.k,(ev.clientY-r.top-est.oy)/est.k]}~~NL~~var tipT=null,tipAlvo=null;~~NL~~function mostrarTip(alvo,ev){~~NL~~var s=alv