a violenta: chuteira nas pernas do adversário, cotovelada, carrinho ou chute com força excessiva. São quase todos cartões vermelhos.""},{""n"":""Infração repetida"",""x"":""Infringir persistentemente as regras do jogo, isto é, várias faltas do mesmo atleta.""},{""n"":""Outros"",""x"":""O que nenhuma das regras acima pegou.""}],""jogos"":[{""n"":1,""f"":1,""r"":1,""d"":""2026-01-10"",""h"":""15:00"",""w"":5,""m"":3388,""v"":58,""gm"":4,""gv"":0,""pm"":null,""pv"":null,""es"":11,""of"":[55,23,41,69,65,22,75],""a1"":4,""a2"":8,""hr"":[""15:00"",""15:49"",""16:04"",""16:57""],""hp"":1,""pu"":1175,""pg"":1171,""rb"":2858000,""ds"":4208380,""rl"":-1350380,""tm"":525,""tv"":509},{""n"":2,""f"":1,""r"":1,""d"":""2026-01-10"",""h"":""16:00"",""w"":5,""m"":3383,""v"":9541,""gm"":2,""gv"":1,""pm"":null,""pv"":null,""es"":13,""of"":[27,4,8,73,10,49,77],""a1"":4,""a2"":5,""hr"":[""16:00"",""16:49"",""17:06"",""17:56""],""hp"":1,""pu"":13091,""pg"":13073,""rb"":87989737,""ds"":34891698,""rl"":53098039,""tm"":515,""tv"":510},{""n"":3,""f"":1,""r"":1,""d"":""2026-01-10"",""h"":""18:30"",""w"":5,""m"":242,""v"":15915,""gm"":1,""gv"":1,""pm"":null,""pv"":null,""es"":1,""of"":[34,11,45,9,1,21,39],""a1"":4,""a2"":7,""hr"":[""18:30"",""19:19"",""19:36"",""20:28""],""hp"":1,""pu"":7484,""pg"":6566,""rb"":15148000,""ds"":7146914,""rl"":8001086,""tm"":522,""tv"":523},{""n"":4,""f"":1,""r"":1,""d"":""2026-01-10"",""h"":""20:30"",""w"":5,""m"":3347,""v"":3320,""gm"":0,""gv"":1,""pm"":null,""pv"":null,""es"":4,""of"":[50,14,18,24,76,38,74],""a1"":3,""a2"":6,""hr"":[""20:30"",""21:18"",""21:33"",""22:24""],""hp"":1,""pu"":9624,""pg"":9624,""rb"":82297500,""ds"":19990180,""rl"":62307320,""tm"":511,""tv"":505},{""n"":5,""f"":1,""r"":1,""d"":""2026-01-11"",""h"":""16:00"",""w"":6,""m"":78,""v"":3344,""gm"":3,""gv"":0,""pm"":null,""pv"":null,""es"":15,""of"":[10,60,35,20,72,6,63],""a1"":3,""a2"":6,""hr"":[""16:00"",""16:48"",""17:03"",""17:54""],""hp"":1,""pu"":36802,""pg"":36662,""rb"":248218290,