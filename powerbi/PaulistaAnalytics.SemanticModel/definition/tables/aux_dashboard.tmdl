;~~NL~~b+='<u style=""background:'+BLOCO_COR[i]+';--w:'+(tot?100*v/tot:0).toFixed(2)+'%""'+tp(x.c+' · '+x.n,linhasTip([['Valor',reais(v)],['Parte das despesas',pc(v,tot)]]),'Bloco do boletim financeiro oficial.')+'></u>';~~NL~~lg+='<span>'+x.c+' <b>'+pc(v,tot)+'</b></span>';~~NL~~});~~NL~~return h+'<div class=""gr"">'+g+'</div><div class=""bl""><div class=""bar"">'+b+'</div><div class=""lgd"">'+lg+'</div></div>';~~NL~~}~~NL~~function porClube(){~~NL~~var m={};~~NL~~D.clubes.forEach(function(c){m[c.id]={c:c,n:0,pu:0,rb:0,rl:0,pg:0,vi:0}});~~NL~~D.jogos.forEach(function(j){~~NL~~if(!noFiltro(j,{clube:true,jogo:true}))return;~~NL~~(est.como==='m'?[j.m]:est.como==='v'?[j.v]:[j.m,j.v]).forEach(function(id){var r=m[id];r.n++;r.pu+=j.pu;r.rb+=j.rb;r.rl+=j.rl;r.pg+=j.pg;r.vi+=j.vi});~~NL~~});~~NL~~return D.clubes.map(function(c){return m[c.id]});~~NL~~}~~NL~~var PAPEL={~~NL~~m:{t:'Por mandante',j:'Jogos em casa',d:'Cada clube com os números dos jogos que fez em casa. Clique em um clube para somar ou tirar do filtro; vários clubes podem ficar escolhidos ao mesmo tempo.'},~~NL~~v:{t:'Por visitante',j:'Jogos fora',d:'Cada clube com os números dos jogos que fez fora de casa. A renda desses jogos é do mandante. Clique em um clube para somar ou tirar do filtro.'},~~NL~~mv:{t:'Por clube',j:'Jogos',d:'Cada clube com os números de todos os jogos dele, em casa e fora. A renda de cada jogo é do mandante. Clique em um clube para somar ou tirar do filtro.'}~~NL~~};~~NL~~var RK={~~NL~~pub:{r:'Público',t:'Público médio',v:function(r){return r.n?r.pu/r.n:0},f:function(v){return num(Math.round(v))},d:{m:'Média de ingressos vendidos nos jogos em casa do clube.',v:'Média de ingressos vendidos nos jogos do clube como visitante.',mv:'Média de ingressos vendidos em todos os jogos do clube, em casa e fora.'}},~~NL~~ren:{r:'Renda',t:'Renda bruta',v:function(r){return r.rb},f:function(v){return mi(v)},d:{m:'Soma da renda bruta dos jogos em casa do clube.',v:'Soma da renda bruta dos jogos do clube c