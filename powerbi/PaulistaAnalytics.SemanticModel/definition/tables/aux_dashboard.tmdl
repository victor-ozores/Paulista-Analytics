	measure html_dashboard_cod_24 = "h;~~NL~~return{n:n,g:meus.length,sof:sof.length,pen:q('p'),fal:q('f'),aut:q('c'),sem:js.filter(function(j){return j.gm+j.gv===0}).length,gpj:n?meus.length/n:0,fx:fx,fs:fs,ft:ft};~~NL~~}~~NL~~function porFase(fn){return[['Todas as fases',fn(resumo('t',est.clube))],['1ª fase',fn(resumo('p',est.clube))],['Mata-mata',fn(resumo('m',est.clube))]]}~~NL~~function jogoTxt(j){return nome(j.m)+' '+j.gm+' × '+j.gv+' '+nome(j.v)}~~NL~~function quemFaz(j){return j.f===1?'1ª fase · rodada '+j.r:FASE[j.f]}~~NL~~function itensKpi(){~~NL~~var c=est.clube,r=resumo(est.fase,c),com=c!==null;~~NL~~var nota='~Este número muda com o filtro de fase'+(com?' e é o do clube escolhido':'; com um clube escolhido ele passa a ser só dos gols desse clube')+'.';~~NL~~return[~~NL~~{r:'Gols',c:COR.rosa,v:num(r.g),s:com?'marcados · sofreu '+num(r.sof):'em '+plural(r.n,'jogo','jogos'),t:['Gols',com?'Gols marcados pelo clube nos jogos do recorte. Os sofridos aparecem no subtítulo.':'Gols do placar, contando pênalti convertido no jogo, gol de falta e gol contra (que vale para o adversário de quem fez). Cobranças da disputa de pênaltis não são gols.',linhasTip(porFase(function(x){return num(x.g)})),nota]},~~NL~~{r:'Gols por jogo',c:COR.amarelo,v:dec(r.gpj,2),s:com?'marcados por jogo':'média do recorte',t:['Gols por jogo','Gols divididos pelos jogos do recorte.',linhasTip(porFase(function(x){return dec(x.gpj,2)})),nota]},~~NL~~{r:'De pênalti',c:COR.ciano,v:num(r.pen),s:pc(r.pen,r.g)+' dos gols',t:['Gols de pênalti','Pênaltis convertidos durante o jogo. As cobranças da disputa de pênaltis não entram.',linhasTip(porFase(function(x){return num(x.pen)})),nota]},~~NL~~{r:'De falta',c:COR.verde,v:num(r.fal),s:pc(r.fal,r.g)+' dos gols',t:['Gols de falta','Gols marcados direto de cobrança de falta.',linhasTip(porFase(function(x){return num(x.fal)})),nota]},~~NL~~{r:'Gols contra',c:COR.vermelho,v:num(r.aut),s:com?'a favor do clube':'autogols',t:['Gols contra','Gols feitos por um jogador contra o próprio time; valem para o adversário e não entram na artilharia.',linhasTip(porFase(function(x){return num(x.aut)})),nota]},~~NL~~{r:'Jogos sem gols',c:COR.roxo,v:num(r.sem),s:pc(r.sem,r.n)+' dos jogos',t:['Jogos sem gols','Jogos que terminaram 0 x 0 no tempo regulamentar.',linhasTip(porFase(function(x){return num(x.sem)})),nota]}~~NL~~];~~NL~~}~~NL~~function kpisHtml(){~~NL~~return itensKpi().map(function(k,i){~~NL~~return'<div class=""kpi"" style=""left:'+(i*307.6).toFixed(1)+'px;--kc:'+k.c+'""'+tp.apply(null,k.t)+'><h4>'+esc(k.r)+'</h4><div class=""v"">'+esc(k.v)+'</div><small>'+esc(k.s)+'</small></div>';~~NL~~}).join('');~~NL~~}~~NL~~function campo(){~~NL~~var r=resumo(est.fase,est.clube),com=est.clube!==null,W=1010,zw=W/6,max=Math.max.apply(null,r.fx.concat([1]));~~NL~~var t1=r.fx[0]+r.fx[1]+r.fx[2],t2=r.fx[3]+r.fx[4]+r.fx[5];~~NL~~var s='<svg viewBox=""0 0 '+W+' 236"" width=""'+W+'"" height=""236"">';~~NL~~s+='<text class=""ct"" x=""'+(1.5*zw)+'"" y=""20"" text-anchor=""middle"">1º tempo · '+plural(t1,'gol','gols')+' ('+pc(t1,r.g)+')</text><text class=""ct"" x=""'+(4.5*zw)+'"" y=""20"" text-anchor=""middle"">2º tempo · '+plural(t2,'gol','gols')+' ('+pc(t2,r.g)+')</text>';~~NL~~s+='<path class=""col"" d=""M8 32H'+(3*zw-8)+'M'+(3*zw+8)+' 32H'+(W-8)+'""/>';~~NL~~for(var i=0;i<6;i++){~~NL~~var a=.1+.62*r.fx[i]/max,t=r.ft[i];~~NL~~var lin=[['Gols',num(r.fx[i])],['Parte dos gols',pc(r.fx[i],r.g)],['De jogo corrido',num(t.g)],['De pênalti',num(t.p)],['De falta',num(t.f)],['Gol contra',num(t.c)]];~~NL~~if(com)lin.push(['Sofridos nesta faixa',num(r.fs[i])]);~~NL~~s+='<g class=""zona""'+tp('Minutos '+FAIXA_NOME[i],linhasTip(lin),'~O acréscimo conta na faixa do tempo: 45+2 vira 31-45 e 90+3 vira 76-90+.')+'><rect x=""'+(i*zw).toFixed(1)+'"" y=""44"" width=""'+zw.toFixed(1)+'"" height=""150"" fill=""rgba(255,111,163,'+a.toFixed(3)+')""/>';~~NL~~s+='<text class=""cn"" x=""'+((i+.5)*zw).toFixed(1)+'"" y=""'+(com?116:126)+'"" text-anchor=""middle"">'+r.fx[i]+'</text><text class=""cp"" x=""'+((i+.5)*zw).toFixed(1)+'"" y=""'+(com?142:152)+'"" text-anchor=""middle"">'+pc(r.fx[i],r.g)+'</text>';~~NL~~if(com)s+='<text x=""'+((i+.5)*zw).toFixed(1)+'"" y=""172"" text-anchor=""middle"">sofridos '+r.fs[i]+'</text>';~~NL~~s+='</g>';~~NL~~}~~NL~~s+='<rect class=""lin"" x=""1"" y=""45"" width=""'+(W-2)+'"" height=""148""/><path class=""lin"" d=""M'+(W/2)+' 45V193""/><circle class=""lin"" cx=""'+(W/2)+'"" cy=""119"" r=""34""/><rect class=""lin"" x=""1"" y=""79"" width=""64"" height=""80""/><rect class=""lin"" x=""'+(W-65)+'"" y=""79"" width=""64"" height=""80""/>';~~NL~~for(var j=0;j<6;j++)s+='<text x=""'+((j+.5)*zw).toFixed(1)+'"" y=""218"" text-anchor=""middle"">'+FAIXAS[j]+' min</text>';~~NL~~return s+'</svg>';~~NL~~}~~NL~~function bloco1(){~~NL~~var r=resumo(est.fase,est.clube);~~NL~~return'<h3><span'+tp('Gols por faixa de minuto','Quantos gols saíram em cada faixa de 15 minutos. Quanto mais forte a cor, mais gols. O meio do campo é o intervalo: à esquerda o 1º tempo, à direita o 2º. Passe o mouse em uma faixa para ver o tipo dos gols.')+'>Gols por faixa de minuto</span><small>'+esc(est.clube===null?FS[est.fase]:nome(est.clube)+' · '+FS[est.fase])+' · '+plural(r.g,'gol','gols')+'</small></h3><div class=""campo"">'+campo()+'</div>';~~NL~~}~~NL~~function ordenar(js,k1,k2){~~NL~~return js.slice().sort(function(a,b){return k1(b)-k1(a)||k2(b)-k2(a)||(a.d<b.d?-1:a.d>b.d?1:0)||a.n-b.n});~~NL~~}~~NL~~function golsDoJogo(j){~~NL~~return D.gols.filter(function(g){return g.j===j.n}).map(function(g){~~NL~~var a=D.atl[g.a].a,t=g.t==='p'?' (pênalti)':g.t==='f'?' (falta)':g.t==='c'?' (gol contra)':'';~~NL~~return[g.mn+""'"",a+' · '+nome(g.k)+t];~~NL~~});~~NL~~}~~NL~~function dicaJogo(j,nota){~~NL~~return[jogoTxt(j),linhasTip([['Jogo',String(j.n)+' · '+dataLonga(j.d)],['Fase',quemFaz(j)],['Placar',jogoTxt(j)]]),golsDoJogo(j).length?linhasTip(golsDoJogo(j)):'Sem gols.',nota];~~NL~~}~~NL~~function colunaJogos(titulo,lista,valor,sufixo,tituloTip,rotulo){~~NL~~var h='<div><h4'+tp(tituloTip[0],tituloTip[1])+'>'+esc(titulo)+'</h4><div class=""rw""><div class=""rola"" data-r=""'+rotulo+'"" style=""max-height:220px"">';~~NL~~if(!lista.length)h+='<div class=""nota"">Sem jogos neste recorte.</div>';~~NL~~lista.forEach(function(j){h+='<div class=""jg""'+tp.apply(null,dicaJogo(j,'~'+sufixo(j)))+'><span class=""pl"">'+valor(j)+'</span><div class=""tx""><b>'+esc(jogoTxt(j))+'</b><small>'+esc(dataBR(j.d)+' · '+quemFaz(j))+'</small></div></div>'});~~NL~~return h+'</div></div></div>';~~NL~~}~~NL~~function bloco2(){~~NL~~var js=nosJogos(est.fase,est.clube),dif=function(j){return Math.abs(j.gm-j.gv)},tot=function(j){return j.gm+j.gv};~~NL~~var h='<h3><span'+tp('Jogos para ver','As maiores goleadas (maior diferença de gols) e os jogos com mais gols do recorte escolhido. Passe o mouse em um jogo para ver os gols, minuto a minuto. Todos os jogos do recorte estão nas listas; role para ver os demais.')+'>Jogos para ver</span><small>'+esc(est.clube===null?FS[est.fase]:nome(est.clube)+' · '+FS[est.fase])+' · '+plural(js.length,'jogo','jogos')+'</small></h3><div class=""jgs"">';~~NL~~h+=colunaJogos('Maiores goleadas',ordenar(js,dif,tot),dif,function(j){return'Diferença de '+plural(dif(j),'gol','gols')+'.'},['Maiores goleadas','Jogos com a maior diferença de gols. Em caso de empate na diferença, vale quem teve mais gols no jogo e, depois, o jogo mais antigo.'],'jg0');~~NL~~h+=colunaJogos('Mais gols no jogo',ordenar(js,tot,dif),tot,function(j){return plural(tot(j),'gol','gols')+' no jogo.'},['Jogos com mais gols','Jogos com o maior total de gols dos dois times. Em caso de empate no total, vale a maior diferença e, depois, o jogo mais antigo.'],'jg1');~~NL~~return h+'</div>';~~NL~~}~~NL~~function artilheiros(){~~NL~~var gs=dosGols(est.fase,est.clube).filter(function(g){return g.t!=='c'&&(est.clube===null||g.c===est.clube)});~~NL~~var m={};~~NL~~gs.forEach(function(g){var a=m[g.a]||(m[g.a]={i:g.a,k:g.k,g:0,p:0,f:0,tot:0});a[g.t]++;a.tot