+;a.js.push(j);~~NL~~if(j.gm>j.gv)a.mand++;else if(j.gm<j.gv)a.vis++;else a.emp++;~~NL~~});~~NL~~return Object.keys(m).map(function(k){return m[k]}).sort(function(x,y){return y.n-x.n||(x.hi+x.lo)-(y.hi+y.lo)||y.hi-x.hi});~~NL~~}~~NL~~function bloco5(){~~NL~~var l=placares(),max=l.length?l[0].n:1,n=nosJogos(est.fase,est.clube).length;~~NL~~var h='<h3><span'+tp('Placares mais comuns','Os resultados que mais se repetiram no recorte escolhido. Um 1 x 0 vale tanto para quem venceu em casa quanto para quem venceu fora; a dica separa os dois. Em caso de empate na contagem, vale o placar com menos gols. Todos os placares do recorte estão na lista; role para ver os menos comuns.')+'>Placares comuns</span><small>'+esc(est.clube===null?FS[est.fase]:nome(est.clube)+' · '+FS[est.fase])+'</small></h3><div class=""rw""><div class=""rola"" data-r=""pl"" style=""max-height:308px"">';~~NL~~if(!l.length)h+='<div class=""nota"">Sem jogos neste recorte.</div>';~~NL~~l.forEach(function(x){~~NL~~var sub=x.hi===x.lo?'empate':'de mandante '+x.mand+' · de visitante '+x.vis;~~NL~~var lin=x.js.slice(0,8).map(function(j){return[dataBR(j.d),jogoTxt(j)]});~~NL~~h+='<div class=""pl2""'+tp('Placar '+x.hi+' × '+x.lo,plural(x.n,'jogo','jogos')+' ('+pc(x.n,n)+' do recorte)',linhasTip(x.hi===x.lo?[['Empates com este placar',String(x.emp)]]:[['Vitórias do mandante',String(x.mand)],['Vitórias do visitante',String(x.vis)]]),linhasTip(lin),x.js.length>8?(x.js.length-8===1?'~e mais 1 jogo não listado.':'~e mais '+(x.js.length-8)+' jogos não listados.'):'~Jogos com este placar.')+'><span class=""sc"">'+x.hi+' × '+x.lo+'</span><div class=""tx""><div class=""bb""><i style=""width:'+(100*x.n/max)+'%""></i></div><small>'+esc(sub)+'</small></div><span class=""ct2"">'+x.n+'</span></div>';~~NL~~});~~NL~~return h+'</div></div><div class=""nota"">'+plural(l.length,'placar diferente','placares diferentes')+' no recorte. O placar vale para os dois lados: 1 × 0 inclui vitória em casa e fora.</div>';~~NL~~}~~NL~~function controles(){~~NL~~var ch=['t','p','m'].map(function(f){return'<button class=""chp'+(est.fase===f?' on':'')+'"" data-act=""fase"" data-v=""'+f+'""'+tp(FS[f],f==='t'?plural(nosJogos('t',null).length,'jogo','jogos')+' do campeonato.':f==='p'?plural(nosJogos('p',null).length,'jogo','jogos')+' da 1ª fase, em pontos corridos.':plural(nosJogos('m',null).length,'jogo','jogos')+' de quartas, semifinais e final.','~Se o clube escolhido não jogou na fase, a escolha dele é solta.')+'><span>'+esc(FS[f])+'</span></button>'}).join('');~~NL~~EL.ctl.innerHTML=ch+'<button class=""chp lim'+(est.fase!=='t'||est.clube!==null?'':' off')+'"" data-act=""limpar""'+tp('Limpar','Volta para todas as fases e solta o clube escolhido.')+'><span>Limpar</span></button><button class=""aju"" data-act=""ajuda""'+tp('Como ler esta tela','Passo a passo e significado das palavras. Atalho: ? ou h.')+'>?</button>';~~NL~~}~~NL~~function cabecalho(){~~NL~~var r=resumo(est.fase,est.clube);~~NL~~EL.sub.textContent=est.clube===null?(est.fase==='t'?'Quando e como saem os gols, e quem os faz · ':FS[est.fase]+' · ')+plural(r.n,'jogo','jogos')+' · '+plural(r.g,'gol','gols'):nome(est.clube)+' · '+FS[est.fase]+' · '+plural(r.n,'jogo','jogos')+' · '+plural(r.g,'gol marcado','gols marcados')+' e '+num(r.sof)+' sofridos';~~NL~~EL.sub.setAttribute('data-tip',['Como usar','Os botões de fase mudam todos os blocos. Clicar em um clube na artilharia ou na lista de gols pró e contra mostra os números só dele (os gols que fez e os que levou); clicar de novo, Limpar ou Esc soltam. O bloco de gols pró e contra continua mostrando os 16 clubes, com o escolhido em destaque.'].map(esc).join('||'));~~NL~~}~~NL~~function montarRodape(){~~NL~~EL.rod.innerHTML='<span'+tp('De onde vêm os números','Os gols vêm das súmulas oficiais da FPF, um a um (jogo, minuto, tipo e atleta). Eles foram conferidos com os placares de todos os jogos, com os indicadores de gols por faixa de minuto, por fase e de pênalti, e com a lista de artilheiros.',linha