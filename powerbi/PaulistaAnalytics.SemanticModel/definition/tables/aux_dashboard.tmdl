	measure html_dashboard_cod_36 = "adores. Cartões sem minuto na súmula ficam na ponta direita.')+'>'+plural(g,'gol','gols')+' · '+plural(c,'cartão','cartões')+' · '+plural(ts.length,'troca','trocas')+'<span class=""lgd""><i class=""gg""></i>gol</span><span class=""lgd""><i class=""aa""></i>amarelo</span><span class=""lgd""><i class=""vv""></i>vermelho</span><span class=""lgd""><i class=""tt""></i>troca</span></small></h3><div class=""tl"">'+linhaDoJogo()+'</div>';~~NL~~}~~NL~~function iconesDe(x){~~NL~~var s='';~~NL~~if(!x)return s;~~NL~~if(x.g)s+='<i class=""bg"">'+x.g+'</i>';~~NL~~if(x.gc)s+='<i class=""bg gc"">'+x.gc+'</i>';~~NL~~if(x.a)s+='<i class=""ca""></i>';~~NL~~if(x.v)s+='<i class=""cv""></i>';~~NL~~if(x.sai)s+='<span class=""sx"">↓'+subTxt(x.sai)+'</span>';~~NL~~if(x.ent)s+='<span class=""se"">↑'+subTxt(x.ent)+'</span>';~~NL~~return s;~~NL~~}~~NL~~function bloco4(){~~NL~~var j=jogoAtual(),i=IX[j.n],rs=resumoJogo(i);~~NL~~var h='<h3><span'+tp('Escalações','Os 11 titulares e o banco de cada time, como a súmula oficial traz: com a camisa, sem a posição em campo e sem a formação (a súmula não informa). No fim de cada linha ficam os gols (círculo branco), os cartões, a saída (seta para baixo) e a entrada (seta para cima) com o minuto; ""int."" é troca no intervalo. Reservas que não entraram ficam apagados. Role para ver o banco.')+'>Escalações</span><small'+tp('Minutos jogados','Minutos jogados de 0 a 90, sem acréscimos e contados até a expulsão, para quem jogou.')+'>'+plural(D.esc[i][0].length+D.esc[i][1].length,'relacionado','relacionados')+'</small></h3><div class=""elc"">';~~NL~~[0,1].forEach(function(lado){~~NL~~var id=clubeDoLado(j,lado),tec=lado===0?j.tm:j.tv;~~NL~~h+='<div class=""elh""><div class=""tn"">'+logo(id,30)+'<b>'+esc(nome(id))+'</b></div><div class=""tc""'+tp('Técnico',tec===null?'O técnico deste time não consta na súmula deste jogo.':D.atl[tec].p)+'>'+(tec===null?'Técnico não consta na súmula':'Técnico: '+esc(D.atl[tec].a))+'</div></div>';~~NL~~});~~NL~~h+='</div><div class=""rw""><div class=""rola"" data-r=""el"" style=""max-height:308px""><div class=""elc"">';~~NL~~[0,1].forEach(function(lado){~~NL~~var id=clubeDoLado(j,lado),linhas=D.esc[i][lado];~~NL~~h+='<div>';~~NL~~linhas.forEach(function(r,k){~~NL~~if(k===11)h+='<div class=""bn"">Banco</div>';~~NL~~var at=D.atl[r[1]],x=rs[lado+'|'+r[0]],mj=r[2],entrou=mj>0||!!(x&&x.ent);~~NL~~var lin=[['Camisa',String(r[0])],['Situação',k<11?'Titular':'Reserva'],['Minutos jogados',mj>0?String(mj):entrou?'0 (entrou no fim do jogo)':'não entrou']];~~NL~~if(x&&x.ent)lin.push(['Entrou',subLong(x.ent)]);~~NL~~if(x&&x.sai)lin.push(['Saiu',subLong(x.sai)]);~~NL~~if(x&&x.g)lin.push(['Gols',String(x.g)]);~~NL~~if(x&&x.gc)lin.push(['Gols contra',String(x.gc)]);~~NL~~if(x&&x.a)lin.push(['Amarelos',String(x.a)]);~~NL~~if(x&&x.v)lin.push(['Vermelhos',String(x.v)]);~~NL~~var conc=(x&&((x.ent&&x.ent.conc)||(x.sai&&x.sai.conc)))?'~Troca por concussão.':'~'+nome(id);~~NL~~h+='<div class=""ln'+(entrou?'':' nj')+'""'+tp.apply(null,[at.p,linhasTip(lin),conc].concat(at.t?['~O nome vem cortado em 33 letras na súmula e pode estar incompleto.']:[]))+'><span class=""cm"">'+r[0]+'</span><span class=""np"">'+esc(at.a)+'</span><span class=""ic"">'+iconesDe(x)+'</span></div>';~~NL~~});~~NL~~h+='</div>';~~NL~~});~~NL~~return h+'</div></div></div>';~~NL~~}~~NL~~function bloco5(){~~NL~~var j=jogoAtual(),i=IX[j.n],l=lances(i);~~NL~~var g=l.filter(function(e){return ehGol(e.t)}).length;~~NL~~var h='<h3><span'+tp('Lances','Os gols e os cartões do jogo na ordem em que aconteceram, com o minuto, o atleta, o clube e o motivo (agrupado, nunca o texto da súmula). Cartões sem minuto na súmula vêm marcados como pós-jogo.')+'>Lances</span><small>'+plural(g,'gol','gols')+' · '+plural(l.length-g,'cartão','cartões')+'</small></h3><div class=""rw""><div class=""rola"" data-r=""ev"" style=""max-height:366px"">';~~NL~~l.forEach(function(e){~~NL~~var id=ehGol(e.t)?e.c:clubeDoLado(j,e.lj),a=D.atl[e.a];~~NL~~h+='<div class=""ev""'+tp.apply(null,tipLance(j,e))+'><span class=""mn"">'+(e.per===4?'pós':minTxt(e.per,e.mn,e.ac))+'</span><div class=""tx""><b>'+esc(a.a)+'</b><small>'+esc(TIPO_NOME[e.t])+'</small></div><span class=""es"">'+logo(id,26)+'</span></div>';~~NL~~});~~NL~~if(!l.length)h+='<div class=""vazio"">Sem gols nem cartões neste jogo.</div>';~~NL~~return h+'</div></div>';~~NL~~}~~NL~~function abaPublico(j){~~NL~~var e=D.est[j.es];~~NL~~var tk=j.pg>0?j.rb/j.pg:0;~~NL~~var h='';~~NL~~h+='<div class=""kv""'+tp('Público','Público informado no boletim financeiro oficial.')+'><span>Público</span><b>'+num(j.pu)+'</b></div>';~~NL~~h+='<div class=""kv""'+tp('Pagantes','Pessoas que pagaram ingresso: '+pc(j.pg,j.pu)+' do público.')+'><span>Pagantes</span><b>'+num(j.pg)+'</b></div>';~~NL~~h+='<div class=""kv""'+tp('Renda bruta','Arrecadação com ingressos antes das despesas.')+'><span>Renda bruta</span><b>'+reais(j.rb)+'</b></div>';~~NL~~h+='<div class=""kv""'+tp('Despesas','Soma dos três blocos de despesa do boletim.')+'><span>Despesas</span><b>'+reais(j.ds)+'</b></div>';~~NL~~h+='<div class=""kv""'+tp('Renda líquida','Renda bruta menos as despesas. Pode ser negativa.')+'><span>Renda líquida</span><b'+(j.rl<0?' class=""neg""':'')+'>'+reais(j.rl)+'</b></div>';~~NL~~h+='<div class=""kv""'+tp('Ticket médio','Renda bruta dividida pelos pagantes.')+'><span>Ticket médio</span><b>'+(j.pg>0?reais(Math.round(tk)):'—')+'</b></div>';~~NL~~h+='<div class=""kv sm""'+tp('Estádio',e.n+' · '+e.m,'~A capacidade dos estádios não foi verificada em fonte oficial, por isso a tela não mostra a ocupação.')+'><span>Estádio</span><b>'+esc(e.n)+' · '+esc(e.m)+'</b></div>';~~NL~~return h;~~NL~~}~~NL~~function abaArbitragem(j){~~NL~~var h='<div class=""rw""><div class=""rola"" data-r=""ab"" style=""max-height:330px"">';~~NL~~PAPEIS.forEach(function(p,k){~~NL~~var n=D.pes[j.of[k]];~~NL~~h+='<div class=""pe""'+tp(p,n,'~Árbitros do jogo, como na súmula oficial.')+'><span>'+p+'</span><b>'+esc(n)+'</b></div>';~~NL~~});~~NL~~h+='<div class=""kv""'+tp('Acréscimos','Minutos de acréscimo dados em cada tempo.')+'><span>Acréscimos</span><b>'+j.a1+' + '+j.a2+' min</b></div>';~~NL~~if(j.hp)h+='<div class=""kv""'+tp('Horários do 1º tempo','Início e fim do 1º tempo, como na súmula.')+'><span>1º tempo</span><b>'+j.hr[0]+'–'+j.hr[1]+'</b></div><div class=""kv""'+tp('Horários do 2º tempo','Início e fim do 2º tempo, como na súmula.')+'><span>2º tempo</span><b>'+j.hr[2]+'–'+j.hr[3]+'</b></div>';~~NL~~else h+='<div class=""aviso""'+tp('Horários da súmula','Início '+j.hr[0]+', fim do 1º tempo '+j.hr[1]+', início do 2º '+j.hr[2]+', fim '+j.hr[3]+'.','~Regra A33 da conferência: as durações dos tempos e do intervalo não são plausíveis; ocorrência aberta, sem outra fonte para corrigir.')+'>Os horários desta súmula não são confiáveis (ficaram zerados); os acréscimos informados valem.</div>';~~NL~~return h+'</div></div>';~~NL~~}~~NL~~function abaEstatisticas(j,i){~~NL~~var h='<div class=""eh"">'+logo(j.m,28)+'<em'+tp('ESPN, não oficial','Estatísticas da ESPN, mantidas por escolha do autor e sempre rotuladas assim; não vêm da súmula oficial da FPF.')+'>ESPN, não oficial</em>'+logo(j.v,28)+'</div>';~~NL~~STATS.forEach(function(s){~~NL~~var a=D.st[i][0][s[1]],b=D.st[i][1][s[1]],t=a+b;~~NL~~var ex=s[1]===7?[['Passes feitos',D.st[i][0][6]+' × '+D.st[i][1][6]],['Acerto de passe',pc(a,D.st[i][0][6])+' × '+pc(b,D.st[i][1][6])]]:[];~~NL~~var vl=s[1]===0?dec(a,1)+'%':String(a),vr=s[1]===0?dec(b,1)+'%':String(b);~~NL~~h+='<div class=""er""'+tp(s[0],linhasTip([[nome(j.m),vl],[nome(j.v),vr]].concat(ex)),'~ESPN, não oficial.')+'><div class=""nm""><b>'+vl+'</b><span>'+esc(s[0])+'</span><b>'+vr+'</b></div><div class=""sp""><i class=""h"" style=""width:'+(t>0?100*a/t:50)+'%""></i><i class=""a"" style=""width:'+(t>0?100*b/t:50)+'%""></i></div></div>';~~NL~~});~~NL~~return h;~~NL~~}~~NL~~function bloco6(){~~NL~~var j=jogoAtual(),i=IX[j.n];~~NL~~var h='<div class=""tabs"">'+['pu','ar','es'].map(function(k){return'<button class=""tb'+(est.aba===k?' on':'')+'"" data-act=""aba"" data-v=""'+k+'""'+tp(ABAS[k],{pu:'Público e renda do jogo, do boletim financeiro oficial.',ar:'Árbitros"
