	/// Pedaço 1 de 7 dos dados da tela Público e renda (JSON com os 72 jogos agregados em centavos: categorias de ingresso, grupos de despesa, blocos, rubricas e divisão da renda). Oculta; gerada por scripts/14_gerar_medida_dashboard.py, não editar à mão.
	measure html_dashboard_dfn_01 = "{""meta"":{""jogos"":72,""regras"":45,""ok"":35,""expl"":7,""aber"":2,""info"":1,""ocorr"":46,""ocorr_abertas"":2},""cat"":[{""n"":""Inteira"",""c"":""#ffd166"",""t"":""Ingressos de preço cheio, chamados de inteira no boletim.""},{""n"":""Meia-entrada"",""c"":""#4cc9f0"",""t"":""Ingressos de meia-entrada, inclusive a meia por lei para menores de 12 anos.""},{""n"":""Sócio-torcedor"",""c"":""#2fd47a"",""t"":""Ingressos de programas de sócio dos clubes: Sócio, Fiel Torcedor, Avanti, Carnê, Palmeiras Pay, Carteirinha e ST. Se o nome diz sócio, conta aqui mesmo que também diga meia ou inteira.""},{""n"":""Cadeira e camarote"",""c"":""#b388ff"",""t"":""Cadeiras de proprietário ou vitalícias, TC10, camarotes, tribuna, suítes, áreas restritas e vendas proibidas. Só conta aqui quando o nome não diz sócio, meia nem inteira.""},{""n"":""Gratuidade por lei"",""c"":""#9aa6b8"",""t"":""Ingressos de preço zero. Todos citam uma lei de gratuidade no nome do setor, por exemplo menores de 2 anos (lei estadual 18.159) e leis municipais.""},{""n"":""Outros"",""c"":""#5b6679"",""t"":""O que nenhuma regra pegou (acompanhante de PCD, passaporte e PCR): menos de 0,1% dos ingressos.""}],""grp"":[{""n"":""Segurança e ordem"",""v"":414089755},{""n"":""Ingressos e acesso"",""v"":318760127},{""n"":""Taxas da FPF e seguro"",""v"":297554653},{""n"":""Pessoal e organização"",""v"":236306730},{""n"":""Impostos e INSS"",""v"":215636635},{""n"":""Repasse ao visitante"",""v"":201794828},{""n"":""Estrutura e serviços"",""v"":140334624},{""n"":""Aluguel do estádio"",""v"":95600000},{""n"":""Saúde e antidoping"",""v"":83293010},{""n"":""Trânsito e transporte"",""v"":37104352}],""blo"":[{""c"":""B1"",""n"":""Aluguéis e seguros""},{""c"":""B2"",""n"":""Taxas e impostos""},{""c"":""B3"",""n"":""Despesas operacionais""}],""rub"":[[""Segurança Privada"",0,2],[""5% - FPF"",2,1],[""35% - RENDA BRUTA CLUBE VISITANTE"",5,1],[""5% INSS Renda Bruta"",4,1],[""Emissão de Ingressos"",1,2],[""Orientadores"",0,2],[""Aluguel de Campo"",7,0],[""Ingressos e Controle de Acesso"",1,2],[""Fundo de Prom. e Desenv do Fut. Pta."",2,1],[""Funcionários"",3,2],[""Alimentação / Prest. Serviço / Staff / Policiamento"",3,2],[""Equipe de Apoio"",3,2],[""2% ISS"",4,1],[""Antidoping A1"",8,2],[""Sonorização"",6,2],[""Ambulância"",8,2],[""Limpeza, Higienização e Sanitização"",6,2],[""Geradores"",6,2],[""Gradeamento"",0,2],[""Locação de Catracas"",1,2],[""Quadro Móvel do Clube"",3,2],[""Brigada de Incêndio - Bombeiro"",0,2],[""CET"",9,2],[""Locação de Equipamentos e Manutenção"",6,2],[""Controladores de Acesso"",1,2],[""Banheiros Químicos"",6,2],[""Ambulatório"",8,2],[""ESTACIONAMENTO"",9,2],[""Arrecadador"",1,2],[""DELEGADO/DIRETOR DE JOGO"",3,2],[""Gerente de Operações"",3,2],[""Monitoramento Por Imagem"",0,2],[""Bilheteiros"",1,2],[""Transporte - Pessoal à Serviço"",9,2],[""Gandulas e Maqueiros"",3,2],[""Prestadores de Serviços"",3,2],[""Policiamento"",0,2],[""20% INSS Sobre Quadro Móvel - Clube"",4,1],[""Seguro Público Pagante - FPF"",2,0],[""ALUGUEL DE CAMPO E DESPESAS OPERACIONAIS"",7,2],[""Antidoping A1 - Partida Adiada"",8,2],[""20% INSS Prestadores de Serviços"",4,1],[""CET - Comunicação Visual"",9,2]],""clubes"":[{""id"":""42"",""nome"":""Botafogo"",""curto"":""Botafogo"",""sigla"":""BFC"",""cor"":""#ff2e32""},{""id"":""58"",""nome"":""Capivariano"",""curto"":""Capivariano"",""sigla"":""CAP"",""cor"":""#cd362c""},{""id"":""78"",""nome"":""Corinthians"",""curto"":""Corinthians"",""sigla"":""COR"",""cor"":""#2b3340""},{""id"":""9541"",""nome"":""Grêmio Novorizontino"",""curto"":""Novorizontino"",""sigla"":""NOV"",""cor"":""#fef800""},{""id"":""242"",""nome"":""Guarani"",""curto"":""Guarani"",""sigla"":""GUA"",""cor"":""#026d4c""},{""id"":""3293"",""nome"":""Mirassol"",""curto"":""Mirassol"",""sigla"":""MIR"",""cor"":""#fbea00""},{""id"":""3303"",""nome"":""Noroeste"",""curto"":""Noroeste"",""sigla"":""NOR"",""cor"":""#d50c07""},{""id"":""3320"",""nome"":""Pal