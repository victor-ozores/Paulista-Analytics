}~~NL~~#glx .aj h2{grid-column:1 / span 2;margin:0;font:italic 900 34px var(--disp);text-transform:uppercase}~~NL~~#glx .aj h3{margin:0 0 10px;font-size:18px;letter-spacing:.12em;color:var(--gold);text-transform:uppercase}~~NL~~#glx .aj ol{margin:0;padding-left:26px}~~NL~~#glx .aj li{font-size:19px;line-height:1.45;color:var(--txt);margin:0 0 10px}~~NL~~#glx .aj dl{margin:0}~~NL~~#glx .aj dt{font-weight:800;color:#fff;font-size:19px}~~NL~~#glx .aj dd{margin:0 0 9px;font-size:18px;line-height:1.4;color:#c3ccda}~~NL~~#glx .aj .fe{grid-column:1 / span 2;display:flex;justify-content:flex-end;align-items:center}~~NL~~#glx .aj .fe button{padding:10px 26px;font-size:17px;font-weight:800;border:1px solid var(--gold);background:var(--gold);color:#12151c}~~NL~~#glx.go .kpi,#glx.go .pn{animation:gl-sobe .55s both}~~NL~~#glx.go .kpi:nth-child(2){animation-delay:.05s}~~NL~~#glx.go .kpi:nth-child(3){animation-delay:.1s}~~NL~~#glx.go .kpi:nth-child(4){animation-delay:.15s}~~NL~~#glx.go .kpi:nth-child(5){animation-delay:.2s}~~NL~~#glx.go .kpi:nth-child(6){animation-delay:.25s}~~NL~~#glx.go .p1{animation-delay:.3s}~~NL~~#glx.go .p2{animation-delay:.38s}~~NL~~#glx.go .p3{animation-delay:.46s}~~NL~~#glx.go .p4{animation-delay:.54s}~~NL~~#glx.go .p5{animation-delay:.62s}~~NL~~#glx.rm *{animation:none!important;transition:none!important}~~NL~~@keyframes gl-sobe{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}~~NL~~</style>~~NL~~<div id=""glx"" tabindex=""0"">~~NL~~<div class=""palco""><div class=""fundo""></div><div class=""faixa""></div><div class=""tit"">Gols <b>e</b> artilharia</div><div class=""sub""></div><div class=""ctl""></div><div class=""kpis""></div><div class=""pn p1""></div><div class=""pn p2""></div><div class=""pn p3""></div><div class=""pn p4""></div><div class=""pn p5""></div><div class=""rod""></div><div class=""aj"" role=""dialog"" aria-modal=""true"" aria-label=""Como ler esta tela""></div><div class=""tip""></div></div>~~NL~~</div>~~NL~~<script>~~NL~~(function(){~~NL~~var D=__DADOS_GL__;~~NL~~var raiz=document.getElementById('glx'),palco=raiz.querySelector('.palco'),tipEl=raiz.querySelector('.tip'),ajEl=raiz.querySelector('.aj');~~NL~~var EL={sub:raiz.querySelector('.sub'),ctl:raiz.querySelector('.ctl'),kpis:raiz.querySelector('.kpis'),p1:raiz.querySelector('.p1'),p2:raiz.querySelector('.p2'),p3:raiz.querySelector('.p3'),p4:raiz.querySelector('.p4'),p5:raiz.querySelector('.p5'),rod:raiz.querySelector('.rod')};~~NL~~var COR={ciano:'#4cc9f0',verde:'#2fd47a',verdeClaro:'#79e7a6',vermelho:'#ff5470',amarelo:'#ffd166',roxo:'#b388ff',rosa:'#ff6fa3',cinza:'#9aa6b8'};~~NL~~var CL={},LG={},IJ={};~~NL~~D.clubes.forEach(function(c){CL[c.id]=c});~~NL~~D.jogos.forEach(function(j){IJ[j.n]=j});~~NL~~if(window.PA&&window.PA.clubes)window.PA.clubes.forEach(function(c){LG[c.id]=c.logo});~~NL~~var FS={t:'Todas as fases',p:'1ª fase',m:'Mata-mata'};~~NL~~var FASE={1:'1ª fase',2:'Quartas de final',3:'Semifinal',4:'Final'};~~NL~~var FX={t:function(){return true},p:function(j){return j.f===1},m:function(j){return j.f>1}};~~NL~~var FAIXAS=['01-15','16-30','31-45','46-60','61-75','76-90+'];~~NL~~var FAIXA_NOME=['1 a 15','16 a 30','31 a 45','46 a 60','61 a 75','76 a 90 e acréscimos'];~~NL~~var TIPO={g:'de jogo corrido',p:'de pênalti',f:'de falta',c:'gol contra'};~~NL~~var est={fase:'t',clube:null,k:1,ox:0,oy:0};~~NL~~var reduzido=!!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches);~~NL~~if(reduzido)raiz.classList.add('rm');~~NL~~function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/""/g,'&quot;')}~~NL~~function num(n){return Number(n).toLocaleString('pt-BR')}~~NL~~function dec(n,c){return Number(n).toLocaleString('pt-BR',{minimumFractionDigits:c,maximumFractionDigits:c})}~~NL~~function pc(a,b){return b>0?dec(100*a/b,1)+'%':'—'}~~NL~~function sinal(n){return n>0?'+'+num(n):n<0?'−'+num(-n):'0'}~~NL~~function dataBR(d){var p=d.split('-');return p[2]+'/'+p[1]}~~NL~~function dataLonga(d){var p=d.split('-');return p[2]+'/'+p[1]+'/'+p[0]}~~NL~~function plural(n,u,p){return num(n)+' '+(n===1?u:p)}~~NL~~function tp(){return' data-tip=""'+Array.prototype.slice.call(arguments).map(esc).join('||')+'""'}~~NL~~function linhasTip(l){return'@'+l.map(function(x){return x[0]+'::'+x[1]}).join('\n')}~~NL~~function tipHtml(s){~~NL~~var sec=String(s).split('||'),h='<b>'+esc(sec[0])+'</b>';~~NL~~for(var i=1;i<sec.length;i++){~~NL~~var x=sec[i];if(!x)continue;~~NL~~if(x.charAt(0)==='@')h+='<div class=""tv"">'+x.slice(1).split('\n').map(function(l){var p=l.split('::');return'<div><span>'+esc(p[0])+'</span><em>'+esc(p[1]===undefined?'':p[1])+'</em></div>'}).join('')+'</div>';~~NL~~else if(x.charAt(0)==='~')h+='<small>'+esc(x.slice(1))+'</small>';~~NL~~else h+='<span>'+esc(x)+'</span>';~~NL~~}~~NL~~return h;~~NL~~}~~NL~~function nome(id){return CL[id].curto}~~NL~~function logo(id,t){~~NL~~var c=CL[id];~~NL~~if(LG[id])return'<img src=""'+LG[id]+'"" alt=""""'+(t?' style=""width:'+t+'px;height:'+t+'px""':'')+'>';~~NL~~return'<span class=""sg"" style=""background:'+c.cor+(t?';width:'+t+'px;height:'+t+'px':'')+'"">'+esc(c.sigla.charAt(0))+'</span>';~~NL~~}~~NL~~function nosJogos(f,c){return D.jogos.filter(function(j){return FX[f](j)&&(c===null||j.m===c||j.v===c)})}~~NL~~function dosGols(f,c){return D.gols.filter(function(g){var j=IJ[g.j];return FX[f](j)&&(c===null||j.m===c||j.v===c)})}~~NL~~function faixaDe(mn){return mn<=15?0:mn<=30?1:mn<=45?2:mn<=60?3:mn<=75?4:5}~~NL~~function resumo(f,c){~~NL~~var js=nosJogos(f,c),gs=dosGols(f,c);~~NL~~var meus=c===null?gs:gs.filter(function(g){return g.c===c}),sof=c===null?[]:gs.filter(function(g){return g.c!==c});~~NL~~var fx=[0,0,0,0,0,0],fs=[0,0,0,0,0,0],ft=[{g:0,p:0,f:0,c:0},{g:0,p:0,f:0,c:0},{g:0,p:0,f:0,c:0},{g:0,p:0,f:0,c:0},{g:0,p:0,f:0,c:0},{g:0,p:0,f:0,c:0}];~~NL~~meus.forEach(function(g){var i=faixaDe(g.mn);fx[i]++;ft[i][g.t]++});~~NL~~sof.forEach(function(g){fs[faixaDe(g.mn)]++});~~NL~~var q