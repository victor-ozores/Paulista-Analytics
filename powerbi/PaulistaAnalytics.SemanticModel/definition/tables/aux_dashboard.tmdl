'Jogos apitados como árbitro principal.')+'>J</span><span'+tp('Cartões amarelos','Amarelos mostrados nesses jogos, aos dois times.')+'>Am.</span><span'+tp('Cartões vermelhos','Vermelhos (diretos e por segundo amarelo) nesses jogos.')+'>Verm.</span><span'+tp('Cartões por jogo','Amarelos mais vermelhos, divididos pelos jogos do árbitro.')+'>C/J</span><span'+tp('Gols de pênalti','Pênaltis convertidos durante os jogos dele.')+'>Pên.</span><span'+tp('Acréscimo médio','Minutos de acréscimo dados por jogo (1º tempo mais 2º tempo).')+'>Acr.</span></div>';~~NL~~h+='<div class=""rw""><div class=""rola"" data-r=""ar"" style=""max-height:300px"">';~~NL~~l.forEach(function(x){~~NL~~var n=x.js.length,tot=x.am+x.vm,a=D.arb[x.i];~~NL~~var lin=[['Jogos',String(n)],['Amarelos',String(x.am)],['Vermelhos',String(x.vm)],['Cartões por jogo',dec(tot/n,2)],['Gols de pênalti',String(x.pn)],['Acréscimo médio (1º + 2º tempo)',dec((x.a1+x.a2)/n,1)+' min'],['Acréscimo médio do 1º tempo',dec(x.a1/n,1)+' min'],['Acréscimo médio do 2º tempo',dec(x.a2/n,1)+' min']];~~NL~~h+='<div class=""ar""'+tp(a,linhasTip(lin),linhasTip(x.js.map(function(j){return[dataBR(j.d)+' · '+jogoTxt(j),plural(CJ[j.n].a+CJ[j.n].r,'cartão','cartões')]})),'~Amostra pequena: não é avaliação de desempenho.')+'><span class=""nm"">'+esc(a)+'</span><i>'+n+'</i><i class=""am"">'+x.am+'</i><i class=""vm"">'+x.vm+'</i><i>'+dec(tot/n,2)+'</i><i class=""mut"">'+x.pn+'</i><i class=""mut"">'+dec((x.a1+x.a2)/n,1)+'</i></div>';~~NL~~});~~NL~~return h+'</div></div><div class=""aviso"">Amostra pequena: no máximo '+maxJogos()+' jogos por árbitro. Não é avaliação de desempenho.</div>';~~NL~~}~~NL~~function atletas(){~~NL~~var m={};~~NL~~cartoesDe(est.fase,est.clube).forEach(function(x){if(x.f!==0)return;var k=x.p+'|'+x.c,a=m[k]||(m[k]={p:x.p,c:x.c,a:0,r:0});if(x.t==='a')a.a++;else a.r++});~~NL~~return Object.keys(m).map(function(k){return m[k]}).sort(function(x,y){return(y.a+y.r)-(x.a+x.r)||y.r-x.r||(D.atl[x.p].p<D.atl[y.p].p?-1:D.atl[x.p].p>D.atl[y.p].p?1:0)||x.c-y.c});~~NL~~}~~NL~~function bloco5(){~~NL~~var l=atletas();~~NL~~var h='<h3><span'+tp('Atletas mais advertidos','Os atletas com mais cartões no recorte escolhido (técnicos e auxiliares ficam de fora e aparecem no quadro de cartões à comissão técnica). Role a lista para ver os demais. Clique em uma linha para escolher o clube do atleta.')+'>Mais advertidos</span><small>'+plural(l.length,'atleta','atletas')+'</small></h3><div class=""rw""><div class=""rola"" data-r=""at"" style=""max-height:330px"">';~~NL~~l.forEach(function(x,i){~~NL~~var at=D.atl[x.p],cl=x.c===est.clube?' sel':est.clube===null?'':' sem';~~NL~~h+='<button class=""at'+cl+'"" data-act=""clube"" data-id=""'+x.c+'""'+tp(at.p+' · '+nome(x.c),linhasTip([['Cartões',String(x.a+x.r)],['Amarelos',String(x.a)],['Vermelhos',String(x.r)]]),'~Clique para escolher o clube do atleta.')+'><span class=""ps"">'+(i+1)+'</span><span class=""esc"">'+logo(x.c,26)+'</span><div class=""tx"">'+esc(at.a)+' <small>'+esc(CL[x.c].sigla)+'</small></div><span class=""na"">'+x.a+'</span><span class=""nv"">'+x.r+'</span></button>';~~NL~~});~~NL~~if(!l.length)h+='<div class=""nota"">Nenhum atleta advertido neste recorte.</div>';~~NL~~return h+'</div></div><div class=""lg2""><span class=""a"">Amarelos</span><span class=""v"">Vermelhos</span></div>';~~NL~~}~~NL~~function controles(){~~NL~~var ch=['t','p','m'].map(function(f){return'<button class=""chp'+(est.fase===f?' on':'')+'"" data-act=""fase"" data-v=""'+f+'""'+tp(FS[f],f==='t'?plural(nosJogos('t',null).length,'jogo','jogos')+' do campeonato.':f==='p'?plural(nosJogos('p',null).length,'jogo','jogos')+' da 1ª fase, em pontos corridos.':plural(nosJogos('m',null).length,'jogo','jogos')+' de quartas, semifinais e final.','~Se o clube escolhido não jogou na fase, a escolha dele é solta.')+'><span>'+esc(FS[f])+'</span></button>'}).join('');~~NL~~EL.ctl.innerHTML=ch+'<button class=""chp lim'+(est.fase!=='t'||est.clube!==null?'':' off')+'"" data-act=""limpar""'+tp('Limpar','Volta para todas as fases e solta o clube escolhido.')+'><span>Limpar</span></button><button class=""aju"" data-act=""ajuda""'+tp('Como ler esta tela','Passo a passo e significado das palavras. Atalho: ? ou h.')+'>?</button>';~~NL~~}~~NL~~function cabecalho(){~~NL~~var r=resumo(est.fase,est.clube);~~NL~~EL.sub.textContent=(est.clube===null?(est.fase==='t'?'Quanto se pune em campo e onde · ':FS[est.fase]+' · '):nome(est.clube)+' · '+FS[est.fase]+' · ')+plural(r.n,'jogo','jogos')+' · '+plural(r.tot,'cartão','cartões');~~NL~~EL.sub.setAttribute('data-tip',['Como usar','Os botões de fase mudam todos os blocos. Clicar em um clube na lista de cartões por clube ou nos atletas mais advertidos mostra os números só dele; clicar de novo, Limpar ou Esc soltam. A lista de cartões por clube e a de árbitros continuam com todos.'].map(esc).join('||'));~~NL~~}~~NL~~function montarRodape(){~~NL~~EL.rod.innerHTML='<span'+tp('De onde vêm os números','Os cartões vêm das súmulas oficiais da FPF, um a um (jogo, minuto, tipo, atleta ou comissão e motivo). Eles foram conferidos com os indicadores de amarelos e vermelhos, geral e por clube, com os acréscimos e com os gols de pênalti.',linhasTip([['Cartões conferidos',num(D.cart.length)],['Jogos',num(D.jogos.length)]]))+'>Dados: súmulas oficiais da FPF · <b>cartões conferidos com os indicadores</b></span><span>Projeto independente, sem vínculo com a FPF · escudos são marcas dos clubes</span>';~~NL~~}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>Em cima: seis números dos cartões (amarelos, vermelhos, por jogo, segundos amarelos, jogos com vermelho e cartões à comissão técnica).</li><li>O <b>campo</b> mostra em que faixa de minuto saem os cartões; o meio é o intervalo.</li><li>Os botões <b>Todas as fases</b>, <b>1ª fase</b> e <b>Mata-mata</b> mudam todos os blocos.</li><li>Clique em um clube na lista de <b>cartões por clube</b> ou nos <b>mais advertidos</