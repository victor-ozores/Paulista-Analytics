	measure html_dashboard_cod_10 = "ss=""fp '+f[0]+(f[1]?' pn':'')+'"" style=""animation-delay:'+(1.95+i*.05).toFixed(2)+'s""'+tp(rotulo(j)+' · '+dataBR(j.d),linhasTip(l),f[1]?'Empate no tempo normal; o jogo foi decidido nos pênaltis.':'')+'><span>'+f[0]+'</span></span>';~~NL~~}).join('');~~NL~~var art=c.art.map(function(a){return'<div'+tp(a[2],linhasTip([['Gols',a[1]],['Clube',c.curto]]),'~Gol de pênalti e de falta contam; gol contra não.')+'><span>'+esc(a[0])+'</span><b>'+a[1]+'</b></div>'}).join('');~~NL~~return'<h4'+tp('Fase alcançada','Até onde o clube chegou no campeonato.')+'>Fase alcançada</h4><div class=""fase'+(c.fase==='Campeão'?' ouro':'')+'""'+tp(FASE_LBL[c.fase],FASE_TIP[c.fase])+'>'+esc(FASE_LBL[c.fase])+'</div><h4'+tp('Últimos resultados',linhasTip([['V','vitória'],['E','empate'],['D','derrota']]),'Um quadrado por jogo, do primeiro ao último. Borda dourada: decidido nos pênaltis.')+'>Últimos resultados</h4><div class=""forma"">'+forma+'</div><h4'+tp('Maiores artilheiros','Os 3 jogadores do clube com mais gols em 2026.')+'>Maiores artilheiros</h4><div class=""art"">'+art+'</div><h4'+tp('Estádio de casa','Estádio onde o clube mais jogou como mandante.')+'>Estádio de casa</h4><div class=""casa""'+tp('Estádio de casa',linhasTip([['Estádio',c.casa],['Cidade',c.cidade],['Jogos em casa aqui',c.casan+' de '+c.jm]]))+'>'+esc(c.casa)+' · '+esc(c.cidade)+'</div>';~~NL~~}~~NL~~function htmlVS(A,B){~~NL~~var js=confrontos(A.id,B.id),ta=tamanho(A.curto,760,74),tb=tamanho(B.curto,760,74),r=resumo(A,B);~~NL~~var texto=esc(r.criterios+' '+r.fase1).replace(esc(A.curto),'<b>'+esc(A.curto)+'</b>').replace(esc(B.curto),'<b>'+esc(B.curto)+'</b>');~~NL~~function lado(c,l){return'<div class=""lado '+l+'""><div class=""tex""></div><div class=""raios""></div><img class=""fant"" src=""'+c.logo+'"" alt=""""></div>'}~~NL~~return lado(A,'a')+lado(B,'b')+'<div class=""fococ""><div class=""foco""></div></div>'+~~NL~~'<svg class=""seam"" viewBox=""0 0 1920 1080""><line class=""s1"" x1=""1038"" y1=""0"" x2=""757"" y2=""1080""/><line class=""s2"" x1=""1038"" y1=""0"" x2=""757"" y2=""1080""/></svg>'+~~NL~~'<div class=""topo""><button class=""btn"" data-act=""voltar""'+tp('Trocar clubes','Volta para a escolha dos clubes.')+'><span>‹ Trocar clubes</span></button><div class=""ctx"">Duelo · Paulistão A1 2026</div><button class=""aju"" data-act=""ajuda"" aria-label=""Como ler esta tela""'+tp('Como ler esta tela','Abre uma explicação rápida desta tela e dos termos que aparecem nela.')+'>?</button></div>'+~~NL~~'<div class=""cr2 a""><div class=""pz""><img src=""'+A.logo+'"" alt=""""></div></div><div class=""cr2 b""><div class=""pz""><img src=""'+B.logo+'"" alt=""""></div></div>'+~~NL~~'<div class=""nm2 a"" style=""font-size:'+ta+'px"">'+esc(A.curto)+'</div><div class=""nm2 b"" style=""font-size:'+tb+'px"">'+esc(B.curto)+'</div>'+~~NL~~'<div class=""ch2 a"">'+chips(A)+'</div><div class=""ch2 b"">'+chips(B)+'</div>'+~~NL~~'<div class=""vsb""><div class=""vi""><svg viewBox=""0 0 400 340""><defs><linearGradient id=""vxg"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0"" stop-color=""#ffffff""/><stop offset="".5"" stop-color=""#ffe28a""/><stop offset=""1"" stop-color=""#ff9f1c""/></linearGradient></defs><g font-family=""Arial Black,Segoe UI Black,Arial,sans-serif"" font-weight=""900"" font-style=""italic"" font-size=""260"" paint-order=""stroke"" stroke=""#0b0e13"" stroke-width=""22"" stroke-linejoin=""round"" fill=""url(#vxg)""><text x=""28"" y=""212"">V</text><text x=""188"" y=""282"">S</text></g></svg></div><i class=""anel""></i><i class=""anel r2""></i></div>'+~~NL~~'<div class=""res""'+tp('Resumo do duelo','Frases geradas a partir dos números abaixo. Passe o mouse sobre cada linha do comparativo para ver o que ela significa.')+'>'+texto+'</div>'+~~NL~~'<div class=""pnl fl a"">'+flanco(A)+'</div><div class=""pnl fl b"">'+flanco(B)+'</div>'+~~NL~~'<div class=""pnl cen""><div class=""abas2""><button class=""ab"" data-act=""tab"" data-v=""comp""'+tp('Comparativo','Os dois clubes lado a lado em 11 critérios. A barra maior é a do melhor desempenho.')+'><span>Comparativo</span></button><button class=""ab"" data-act=""tab"" data-v=""conf""'+tp('Confronto direto','Jogos entre os dois clubes em 2026, com gols e cartões no minuto em que aconteceram.')+'><span>Confronto direto<em>'+js.length+'</em></span></button></div><div class=""cc""></div></div>';~~NL~~}~~NL~~function abrirVS(a,b,jid){~~NL~~limpar();esconderTip();ajuda(false);~~NL~~est.a=a;est.b=b;est.jogo=jid||null;est.tab=jid?'conf':'comp';est.tela='vs';~~NL~~var A=CL[a],B=CL[b],p=par(A,B);~~NL~~est.pal={};est.pal[a]=p[0];est.pal[b]=p[1];~~NL~~vs.style.cssText='--a:'+p[0].c+';--al:'+p[0].l+';--ad:'+p[0].d+';--ia:'+p[0].ink+';--b:'+p[1].c+';--bl:'+p[1].l+';--bd:'+p[1].d+';--ib:'+p[1].ink;~~NL~~vs.className='tela';~~NL~~vs.innerHTML=htmlVS(A,B);~~NL~~reporPz();coletarPz();~~NL~~raiz.classList.remove('sel');raiz.classList.add('vs');~~NL~~fx.modo='vs';fx.ca=[p[0].l,A.cor2,'#ffffff'];fx.cb=[p[1].l,B.cor2,'#ffffff'];fx.P.length=0;aquecer(220);~~NL~~mostrarTab(false);~~NL~~est.primeira=true;~~NL~~void vs.offsetWidth;~~NL~~vs.classList.add('go');~~NL~~if(reduzido){vs.classList.add('fast');mostrarTab(true);return}~~NL~~agendar(function(){flash.classList.remove('on');void flash.offsetWidth;flash.classList.add('on');agita.classList.remove('treme');void agita.offsetWidth;agita.classList.add('treme');rajada(960,240,CFG.brasas.rajada,[p[0].l,p[1].l,'#ffd166','#ffffff'])},1000);~~NL~~agendar(function(){if(est.primeira)mostrarTab(true)},2150);~~NL~~}~~NL~~function voltar(){~~NL~~limpar();esconderTip();ajuda(false);est.tela='sel';vs.className='tela';vs.innerHTML='';reporPz();~~NL~~raiz.classList.remove('vs');raiz.classList.add('sel');fx.modo='sel';~~NL~~atualizarSel();~~NL~~}~~NL~~function abrirJogo(id){var j=JG[id];abrirVS(j.m,j.v,id)}~~NL~~var tipT=null,tipAlvo=null;~~NL~~function mostrarTip(alvo,ev){~~NL~~var s=alvo.getAttribute('data-tip');if(!s)return;~~NL~~tipEl.innerHTML=tipHtml(s);~~NL~~tipEl.classList.add('on');~~NL~~posTip(ev,alvo);~~NL~~}~~NL~~function posTip(ev,alvo){~~NL~~var pt;~~NL~~if(ev&&typeof ev.clientX==='number')pt=pontoPalco(ev);~~NL~~else{var r=alvo.getBoundingClientRect(),q=raiz.getBoundingClientRect();pt=[(r.left+r.width/2-q.left-est.ox)/est.k,(r.top+r.height-q.top-est.oy)/est.k-8]}~~NL~~var w=tipEl.offsetWidth,h=tipEl.offsetHeight,x=pt[0]+22,y=pt[1]+26;~~NL~~if(x+w>1908)x=pt[0]-w-22;~~NL~~if(x<12)x=12;~~NL~~if(y+h>1070)y=pt[1]-h-18;~~NL~~if(y<12)y=12;~~NL~~tipEl.style.left=Math.round(x)+'px';tipEl.style.top=Math.round(y)+'px';~~NL~~}~~NL~~function esconderTip(){clearTimeout(tipT);tipAlvo=null;tipEl.classList.remove('on')}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>Escolha dois clubes na grade, ou a aba Jogos para abrir um jogo. Depois clique em VERSUS.</li><li>No Comparativo, a barra maior é a do melhor desempenho. Quem leva vantagem fica iluminado.</li><li>Passe o mouse sobre qualquer linha, título, resultado, gol ou cartão para ver o que significa.</li><li>No Confronto direto, a faixa de cima é do mandante e a de baixo é do visitante. Cada gol e cada cartão traz o escudo do time que o fez.</li></ol></div><div><h3>Palavras que aparecem</h3><dl><dt>Mandante e visitante</dt><dd>O mandante joga em casa; o visitante joga fora.</dd><dt>Aproveitamento</dt><dd>Pontos conquistados dividido pelos pontos disputados (3 por jogo).</dd><dt>Saldo de gols</dt><dd>Gols marcados menos gols sofridos.</dd><dt>Art. 16</dt><dd>Regra do regulamento que desempata a 1ª fase: vitórias, saldo, gols marcados, menos vermelhos, menos amarelos e sorteio.</dd><dt>Tempo normal</dt><dd>Os 90 minutos (mais acréscimos). Os pênaltis decidem quem avança, mas não viram gol.</dd></dl></div><div class=""fe""><button class=""pri"" data-act=""ajuda-fechar""'+tp('Fechar','Fecha este passo a passo. Também fecham as teclas Esc, Enter e espaço, ou um clique fora da janela.')+'>Entendi</button></div></div>';~~NL~~}~~NL~~function ajuda(abrir){~~NL~~if(abrir===undefined)abrir=!ajEl.classList.contains('on');~~NL~~if(abrir)esconderTip();~~NL~~ajEl.classList.toggle('on',abrir);~~NL~~}~~NL~~functi"
