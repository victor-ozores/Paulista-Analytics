'Troca · '+nome(id),linhasTip([['Saiu',nomeCamisa(i,lado,t.saiu)+' (camisa '+t.saiu+')'],['Entrou',nomeCamisa(i,lado,t.entrou)+' (camisa '+t.entrou+')'],['Quando',subLong(t)]].concat(t.conc?[['Tipo','por concussão']]:[])))+'><rect x=""'+(it.x-7).toFixed(1)+'"" y=""'+(y-6)+'"" width=""14"" height=""12"" rx=""2"" fill=""#4cc9f0""/></g>';~~NL~~});~~NL~~var base=borda+sinal*(10+(nsb-1)*13+6+3+11);~~NL~~var vao=down?(190-11-base):(base-11);~~NL~~var esp=nev>1?Math.min(24,vao/(nev-1)):0;~~NL~~ev.forEach(function(it){~~NL~~var e=it.e,y=base+sinal*it.raia*esp,x=it.x.toFixed(1);~~NL~~var m='<g class=""mk""'+tp.apply(null,tipLance(j,e))+'>';~~NL~~if(ehGol(e.t)){~~NL~~m+='<circle cx=""'+x+'"" cy=""'+y.toFixed(1)+'"" r=""11"" fill=""'+(e.t==='c'?'#ff5470':'#fff')+'"" stroke=""#10141b"" stroke-width=""2""/>';~~NL~~if(e.t!=='g')m+='<text x=""'+x+'"" y=""'+(y+5.5).toFixed(1)+'"" text-anchor=""middle"" style=""fill:'+(e.t==='c'?'#fff':'#10141b')+';font-size:16px;font-weight:900"">'+({p:'P',f:'F',c:'C'})[e.t]+'</text>';~~NL~~}else{~~NL~~if(e.t==='s')m+='<rect x=""'+(it.x-12).toFixed(1)+'"" y=""'+(y-9).toFixed(1)+'"" width=""12"" height=""18"" rx=""2"" fill=""#ffd166""/><rect x=""'+(it.x-4).toFixed(1)+'"" y=""'+(y-10).toFixed(1)+'"" width=""12"" height=""20"" rx=""2"" fill=""#ff5470""/>';~~NL~~else m+='<rect x=""'+(it.x-6).toFixed(1)+'"" y=""'+(y-10).toFixed(1)+'"" width=""12"" height=""20"" rx=""2"" fill=""'+(e.t==='a'?'#ffd166':'#ff5470')+'""/>';~~NL~~}~~NL~~s+=m+'</g>';~~NL~~});~~NL~~});~~NL~~return s+'</svg>';~~NL~~}~~NL~~function bloco3(){~~NL~~var j=jogoAtual(),i=IX[j.n],l=lances(i),ts=trocas(i);~~NL~~var g=l.filter(function(e){return ehGol(e.t)}).length,c=l.length-g;~~NL~~return'<h3><span'+tp('Linha do jogo','Os gols, os cartões e as trocas de cada time nos minutos do jogo: o mandante em cima da linha, o visitante embaixo. O 1º tempo fica à esquerda, o intervalo no meio e o 2º tempo à direita; a faixa dourada é o acréscimo dado pelo árbitro. Passe o mouse em um marcador para ver quem foi.')+'>Linha do jogo</span><small'+tp('Legenda','Círculo branco: gol (P = pênalti, F = falta); círculo vermelho com C: gol contra. Retângulo amarelo ou vermelho: cartão (dois juntos: segundo amarelo e expulsão). Quadradinho azul: troca de jog"
