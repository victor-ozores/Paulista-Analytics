motion: reduce)').matches);~~NL~~if(reduzido)raiz.classList.add('rm');~~NL~~function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/""/g,'&quot;')}~~NL~~function num(n){return Number(n).toLocaleString('pt-BR')}~~NL~~function dec(n,c){return Number(n).toLocaleString('pt-BR',{minimumFractionDigits:c,maximumFractionDigits:c})}~~NL~~function pc(a,b){return b>0?dec(100*a/b,1)+'%':'—'}~~NL~~function reais(c){return'R$ '+dec(c/100,2)}~~NL~~function milhoes(c){return'R$ '+dec(c/100000000,2)+' mi'}~~NL~~function dataBR(d){var p=d.split('-');return p[2]+'/'+p[1]}~~NL~~function dataLonga(d){var p=d.split('-');return p[2]+'/'+p[1]+'/'+p[0]}~~NL~~function plural(n,u,p){return num(n)+' '+(n===1?u:p)}~~NL~~function nomeLista(a){return a.length<2?(a[0]||''):a.slice(0,-1).join(', ')+' e '+a[a.length-1]}~~NL~~function tp(){return' data-tip=""'+Array.prototype.slice.call(arguments).map(esc).join('||')+'""'}~~NL~~function linhasTip(l){return'@'+l.map(function(x){return x[0]+'::'+x[1]}).join('\n')}~~NL~~function tipHtml(s){~~NL~~var sec=String(s).split('||'),h='<b>'+esc(sec[0])+'</b>';~~NL~~for(var i=1;i<sec.length;i++){~~NL~~var x=sec[i];if(!x)continue;~~NL~~if(x.charAt(0)==='@')h+='<div class=""tv"">'+x.slice(1).split('\n').map(function(l){var p=l.split('::');return'<div><span>'+esc(p[0])+'</span><em>'+esc(p[1]===undefined?'':p[1])+'</em></div>'}).join('')+'</div>';~~NL~~else if(x.charAt(0)==='~')h+='<small>'+esc(x.slice(1))+'</small>';~~NL~~else h+='<span>'+esc(x)+'</span>';~~NL~~}~~NL~~return h;~~NL~~}~~NL~~function nome(id){return CL[id].curto}~~NL~~function logo(id,t){~~NL~~var c=CL[id];~~NL~~if(LG[id])return'<img src=""'+LG[id]+'"" alt=""""'+(t?' style=""width:'+t+'px;height:'+t+'px""':'')+'>';~~NL~~return'<span class=""sg"" style=""background:'+c.cor+(t?';width:'+t+'px;height:'+t+'px':'')+'"">'+esc(c.sigla.charAt(0))+'</span>';~~NL~~}~~NL~~function dosJogos(f){return D.jogos.filter(FX[f])}~~NL~~function soma(js,c){return js.reduce(function(s,j){return s+j[c]},0)}~~NL~~function resumo(f){~~NL~~var js=dosJogos(f),n=js.length,g=soma(js,'gm')+soma(js,'gv'),pu=soma(js,'pu'),pg=soma(js,'pg'),rb=soma(js,'rb'),am=soma(js,'am'),vm=soma(js,'vm');~~NL~~var a=js.filter(function(j){return j.gm>j.gv}).length,e=js.filter(function(j){return j.gm===j.gv}).length,b=js.filter(function(j){return j.gm<j.gv}).length;~~NL~~return{n:n,g:g,pu:pu,pg:pg,rb:rb,am:am,vm:vm,a:a,e:e,b:b,gpj:n?g/n:0,pm:n?pu/n:0,tk:pg?rb/pg:0,cpj:n?(am+vm)/n:0};~~NL~~}~~NL~~function jogoTxt(j){return nome(j.m)+' '+j.gm+' × '+j.gv+' '+nome(j.v)}~~NL~~function quemFaz(j){return j.f===1?'1ª fase · rodada '+j.r:FASE[j.f]}~~NL~~function porFase(fn){return[['Todas as fases',fn(resumo('t'))],['1ª fase',fn(resumo('p'))],['Mata-mata',fn(resumo('m'))]]}~~NL~~function itensKpi(){~~NL~~var r=resumo(est.fase),rt=resumo('t');~~NL~~var n1=dosJogos('p').length;~~NL~~var jogosSub=est.fase==='t'?n1+' na 1ª fase e '+(rt.n-n1)+' no mata-mata':est.fase==='p'?rodadas('p').length+' rodadas, pontos corridos':'quartas, semifinais e final';~~NL~~return[~~NL~~{r:'Jogos',c:COR.ciano,v:num(r.n),s:jogosSub,t:['Jogos','Partidas disputadas no recorte escolhido (um jogo é uma partida da A1 2026).',linhasTip(porFase(function(x){return num(x.n)}))]},~~NL~~{r:'Gols',c:COR.verde,v:num(r.g),s:'sem contar pênaltis da disputa',t:['Gols','Gols do placar, contando pênalti convertido no jogo, gol de falta e gol contra (que vale para o adversário de quem fez). Cobranças da disputa de pênaltis não são gols.',linhasTip(porFase(function(x){return num(x.g)}))]},~~NL~~{r:'Gols por jogo',c:COR.amarelo,v:dec(r.gpj,2),s:'média do recorte',t:['Gols por jogo','Gols divididos pelos jogos.',linhasTip(porFase(function(x){return dec(x.gpj,2)}))]},~~NL~~{r:'Público total',c:COR.laranja,v:num(r.pu),s:'ingressos do boletim',t:['Público total','Soma dos ingressos de cada jogo, segundo o boletim financeiro oficial (pagantes mais gratuidades e cortesias).',linhasTip(porFase(function(x){return num(x.pu)