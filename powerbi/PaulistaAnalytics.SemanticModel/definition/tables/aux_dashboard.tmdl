>'+esc(r.x)+'</small>':'')+'</div></div>';~~NL~~if(!r&&!baseOcorr().length)return h+'<div class=""vazio""><div>As regras '+RESPL[est.res]+' não têm ocorrência.<br>Tudo que elas verificaram bateu.</div></div>';~~NL~~return h+'<div class=""vazio""><div>Nenhuma ocorrência com este status'+(r?' nesta regra':est.res!=='t'?' nestas regras':'')+'.<br>Use Todas ou Limpar.</div></div>';~~NL~~}~~NL~~return h+'<div class=""lo"">'+lista.map(ocLinha).join('')+'</div>';~~NL~~}~~NL~~function painelFontes(){~~NL~~var h='<h3><span'+tp('De onde vem cada dado','Quem é a fonte de quê. A FPF oficial é a verdade; a ESPN só entra rotulada, com poucas informações; categorias e grupos são do projeto.')+'>De onde vem cada dado</span></h3>';~~NL~~D.fon.forEach(function(f,i){var b=BADGE[f.k];h+='<div class=""fo"" style=""--i:'+i+'""'+tp(f.f,f.d)+'><span class=""rc '+b[1]+'"">'+b[0]+'</span><u>'+esc(f.t)+'</u></div>'});~~NL~~return h;~~NL~~}~~NL~~function painelCamadas(){~~NL~~var h='<h3><span'+tp('Camadas de conferência','Os números passam por camadas independentes de conferência, da fonte até o Power BI. Passe o mouse em uma camada para ver como foi feita e quando.')+'>Camadas de conferência</span></h3>';~~NL~~D.cam.forEach(function(c,i){h+='<div class=""cm"" style=""--i:'+i+'""'+tp(c.n,c.d,c.q?'~Conferido em '+c.q+'.':'~Repetido a cada mudança no projeto.')+'><i>✔</i><u>'+esc(c.n)+'</u><em>'+esc(c.r)+'</em></div>'});~~NL~~return h;~~NL~~}~~NL~~function painelCorrecao(){~~NL~~var h='<h3><span'+tp('Correção documentada','Quando uma fonte oficial tem um erro evidente, o valor é corrigido na base com fontes citadas e o valor original continua à vista. O PDF da súmula nunca é alterado.')+'>Correção documentada</span></h3>';~~NL~~D.cor.forEach(function(c){~~NL~~h+='<div class=""cr""'+tp(c.i+' · '+c.t,c.x,'~A correção está aplicada e rastreável: a conferência confirma o valor corrigido na base e o original na súmula.')+'><div class=""c1""><b>'+esc(c.i)+'</b><u>'+esc(c.t)+'</u></div><div class=""c2""><span>Súmula<b>'+esc(c.de)+'\'</b></span><i>→</i><span class=""nv"">Base tratada<b>'+esc(c.para)+'\'</b></span></div><div class=""c3"">'+esc(c.d)+' · conferido em '+esc(c.f.join(', '))+'</div></div>';~~NL~~});~~NL~~return h;~~NL~~}~~NL~~function controles(){~~NL~~EL.ctl.innerHTML='<button class=""chp lim'+(temFiltro()?'':' off')+'"" data-act=""limpar""'+tp('Limpar','Solta a regra escolhida e volta os dois filtros para Todas.')+'><span>Limpar</span></button><button class=""aju"" data-act=""ajuda""'+tp('Como ler esta tela','Passo a passo e significado das palavras. Atalho: ? ou h.')+'>?</button>';~~NL~~}~~NL~~function cabecalho(){~~NL~~EL.sub.textContent='PDFs oficiais coletados em '+dataBR(M.pdf)+' · tabela da FPF de '+dataBR(M.fpf)+' · ESPN de '+dataBR(M.espn);~~NL~~EL.sub.setAttribute('data-tip',['Quando os dados foram coletados','Súmulas e boletins oficiais (PDF) coletados em '+dataBR(M.pdf)+'. Tabela de jogos e classificação do portal da FPF atualizadas em '+dataBR(M.fpf)+'. Dados da ESPN coletados em '+dataBR(M.espn)+'. A competição está encerrada: os dados dela não mudam mais.'].map(esc).join('||'));~~NL~~}~~NL~~function montarRodape(){~~NL~~EL.rod.innerHTML='<span'+tp('Como os dados foram conferidos','Esta tela é o detalhe da conferência: as regras, as ocorrências e as camadas.',linhasTip([['Regras de conferência',M.regras],['Sem divergência',M.ok],['Divergência explicada',M.expl],['Em aberto',M.aber],['Informativa',M.info]]))+'>Dados: súmulas e boletins oficiais da FPF · <b>conferidos por '+M.regras+' regras</b> ('+M.aber+' pendências abertas)</span><span>Projeto independente, sem vínculo com a FPF nem com a ESPN</span>';~~NL~~}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>Os sete quadros de cima resumem o resultado das '+M.regras+' regras de conferência.</li><li>Em <b>As regras</b>, escolha o resultado (Todas, Sem ocorrência, Explicadas, Abertas ou Info): as duas listas passam a mostrar só essas regras e as ocorrências delas. Clique em uma regra para ver só o que ela achou; clique de novo para soltar.</li><li>Em <b>As ocorrências</b>, escolha o status. As pendências abertas vêm primeiro. Passe o mouse em uma linha para ler o que cada fonte diz, a decisão e a explicação.</li><li>Os sete quadros de cima resumem toda a conferência e não mudam com os filtros. À direita: de onde vem cada dado, as camadas de conferência e a correção documentada. Limpar (ou a tecla Esc) solta a regra e os filtros.</li></ol></div><div><h3>Palavras que aparecem</h3><dl><dt>Regra</dt><dd>Uma conferência automática: compara duas fontes ou confere uma propriedade dos dados.</dd><dt>Item verificado</dt><dd>Cada jogo, clube, evento ou linha que a regra olhou.</dd><dt>Ocorrência</dt><dd>Um caso em que as fontes divergem ou um dado falta.</dd><dt>Explicada, aceita, corrigida</dt><dd>Explicada: causa conhecida, vale a fonte oficial. Aceita: limitação conhecida. Corrigida: valor ajustado na base com fonte citada.</dd><dt>Aberta</dt><dd>Sem solução com as fontes que existem. Não é erro nos números da tela.</dd><dt>Informativa</dt><dd>Mostra um número para comparação; não aponta erro.</dd><dt>Oficial, não oficial, projeto</dt><dd>Oficial é da FPF. Não oficial é da ESPN. Projeto é classificação feita aqui.</dd></dl></div><div class=""fe""><button data-act=""ajuda-fechar""'+tp('Fechar','Fecha este passo a passo. Também fecham as teclas Esc, Enter e espaço, ou um clique fora da janela.')+'>Entendi</button></div></div>';~~NL~~}~~NL~~function ajuda(abrir){~~NL~~if(abrir===undefined)abrir=!ajEl.classList.contains('on');~~NL~~if(abrir)esconderTip();~~NL~~ajEl.classList.toggle('on',abrir);~~NL~~}~~NL~~var PAIN=['p1','p2','p3','p4','p5'];~~NL~~function atualizar(opc){~~NL~~opc=opc||{};~~NL~~esconderTip();~~NL~~var tb=EL.p1.querySelector('.tb'),rolo=opc.manterRolo&&tb?tb.scrollTop:0;~~NL~~PAIN.forEach(function(p){EL[p].classList.remove('on')});~~NL~~controles();cabecalho();kpis()