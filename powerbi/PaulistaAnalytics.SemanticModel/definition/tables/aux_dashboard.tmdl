M.classif[1]]]));~~NL~~return'<button class=""cfm"" data-act=""conf""'+tip+'><div class=""st""><b>✔</b> '+M.regras+' regras · '+M.ok+' sem ocorrência · '+M.expl+' explicadas · '+M.aber+' abertas</div><small>Placares iguais à FPF: '+M.placar[0]+' de '+M.placar[1]+' · posições: '+M.classif[0]+' de '+M.classif[1]+'. Clique para ver a conferência.</small></button>';~~NL~~}~~NL~~function controles(){~~NL~~var ch=['t','p','m'].map(function(f){return'<button class=""chp'+(est.fase===f?' on':'')+'"" data-act=""fase"" data-v=""'+f+'""'+tp(FS[f],f==='t'?plural(resumo('t').n,'jogo','jogos')+' do campeonato.':f==='p'?plural(resumo('p').n,'jogo','jogos')+' da 1ª fase, em pontos corridos.':plural(resumo('m').n,'jogo','jogos')+' de quartas, semifinais e final.','~O campeão e a conferência não mudam com o filtro.')+'><span>'+esc(FS[f])+'</span></button>'}).join('');~~NL~~EL.ctl.innerHTML=ch+'<button class=""chp lim'+(est.fase!=='t'?'':' off')+'"" data-act=""limpar""'+tp('Limpar','Volta para todas as fases.')+'><span>Limpar</span></button><button class=""aju"" data-act=""ajuda""'+tp('Como ler esta tela','Passo a passo e significado das palavras. Atalho: ? ou h.')+'>?</button>';~~NL~~}~~NL~~function cabecalho(){~~NL~~var r=resumo(est.fase);~~NL~~EL.sub.textContent=est.fase==='t'?'Paulistão A1 2026 em uma olhada · '+plural(r.n,'jogo','jogos')+', '+plural(r.g,'gol','gols')+' e o campeão':FS[est.fase]+' · '+plural(r.n,'jogo','jogos')+' · '+plural(r.g,'gol','gols');~~NL~~EL.sub.setAttribute('data-tip',['Como é o campeonato','A 1ª fase tem os 16 clubes em pontos corridos, com 8 jogos para cada um. Os 8 primeiros vão às quartas de final (1º x 8º, 2º x 7º, 3º x 6º e 4º x 5º), em jogo único, assim como a semifinal; a final tem dois jogos. Use os botões de fase para ver só a 1ª fase ou só o mata-mata.'].map(esc).join('||'));~~NL~~}~~NL~~function montarRodape(){~~NL~~EL.rod.innerHTML='<span'+tp('De onde vêm os números','Placar, público, renda e cartões vêm das fontes oficiais da FPF (tabela de jogos, súmula e boletim financeiro). Os totais foram conferidos com o cálculo independente dos indicadores, fase por fase, e com a lista de artilheiros.',linhasTip([['Regras de conferência',String(M.regras)],['Placares iguais à FPF',M.placar[0]+' de '+M.placar[1]]]))+'>Dados: FPF oficial · <b>totais conferidos com o cálculo independente dos indicadores</b></span><span>Projeto independente, sem vínculo com a FPF · escudos são marcas dos clubes</span>';~~NL~~}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>Em cima: o <b>campeão</b> e o caminho dele, e oito números do campeonato.</li><li>Os botões <b>Todas as fases</b>, <b>1ª fase</b> e <b>Mata-mata</b> mudam os números, o gráfico, o mando, a artilharia e os recordes. O bloco do campeão e a conferência não mudam.</li><li>Passe o mouse nos números, nas barras do gráfico, nos artilheiros e nos recordes para ver os jogos e os detalhes. A dica dos números mostra os três recortes lado a lado.</li><li>Clique no selo de conferência para abrir a tela que mostra como os dados foram conferidos. <b>Limpar</b> ou a tecla Esc voltam para todas as fases.</li></ol></div><div><h3>Palavras que aparecem</h3><dl><dt>Gols por jogo</dt><dd>Gols divididos pelos jogos. Nas barras, é a média de cada rodada, porque as rodadas do mata-mata têm poucos jogos.</dd><dt>Mando</dt><dd>Quem ganha em casa, empata ou perde nos 90 minutos. Pênaltis só decidem quem passa.</dd><dt>Público e renda</dt><dd>Ingressos e arrecadação do boletim financeiro oficial; o ticket médio divide a renda pelos pagantes.</dd><dt>Cartões</dt><dd>Contados pela regra da FPF: todos os amarelos menos os segundos amarelos, mais os vermelhos e os segundos amarelos.</dd><dt>Artilharia</dt><dd>Gols de cada atleta pelo próprio clube, sem gol contra.</dd></dl></div><div class=""fe""><button data-act=""ajuda-fechar""'+tp('Fechar','Fecha este passo a passo. Também fecham as teclas Esc, Enter e espaço, ou um clique fora da janela.')+'>Entendi</button></div></div>';~~NL~~}~~NL~~function ajuda(abrir){~~NL~~if"
