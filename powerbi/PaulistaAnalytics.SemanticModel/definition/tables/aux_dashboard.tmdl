)],['Parte dos cartões',pc(r.fx[i],dentro)],['Amarelos',num(r.fa[i])],['Vermelhos',num(r.fv[i])]];~~NL~~s+='<g class=""zona""'+tp('Minutos '+FAIXA_NOME[i],linhasTip(lin),'~O acréscimo conta na faixa do tempo: 45+2 vira 31-45 e 90+3 vira 76-90+.')+'><rect x=""'+(i*zw).toFixed(1)+'"" y=""44"" width=""'+zw.toFixed(1)+'"" height=""150"" fill=""rgba(255,209,102,'+al.toFixed(3)+')""/>';~~NL~~s+='<text class=""cn"" x=""'+((i+.5)*zw).toFixed(1)+'"" y=""126"" text-anchor=""middle"">'+r.fx[i]+'</text><text class=""cp"" x=""'+((i+.5)*zw).toFixed(1)+'"" y=""152"" text-anchor=""middle"">'+pc(r.fx[i],dentro)+'</text></g>';~~NL~~}~~NL~~s+='<rect class=""lin"" x=""1"" y=""45"" width=""'+(W-2)+'"" height=""148""/><path class=""lin"" d=""M'+(W/2)+' 45V193""/><circle class=""lin"" cx=""'+(W/2)+'"" cy=""119"" r=""34""/><rect class=""lin"" x=""1"" y=""79"" width=""64"" height=""80""/><rect class=""lin"" x=""'+(W-65)+'"" y=""79"" width=""64"" height=""80""/>';~~NL~~for(var j=0;j<6;j++)s+='<text x=""'+((j+.5)*zw).toFixed(1)+'"" y=""218"" text-anchor=""middle"">'+FAIXAS[j]+' min</text>';~~NL~~return s+'</svg>';~~NL~~}~~NL~~function bloco1(){~~NL~~var r=resumo(est.fase,est.clube);~~NL~~return'<h3><span'+tp('Cartões por faixa de minuto','Quantos cartões saíram em cada faixa de 15 minutos. Quanto mais forte a cor, mais cartões. O meio do campo é o intervalo: à esquerda o 1º tempo, à direita o 2º. Passe o mouse em uma faixa para ver quantos foram amarelos e quantos vermelhos.')+'>Cartões por faixa de minuto</span><small>'+esc(rotulo())+' · '+plural(r.tot,'cartão','cartões')+(r.sem?' · <em'+tp('Cartões sem minuto',plural(r.sem,'cartão','cartões')+' '+(r.sem===1?'veio marcado':'vieram marcados')+' como pós-jogo, sem minuto, na súmula. '+(r.sem===1?'Ele conta':'Eles contam')+' nos totais e nos outros quadros, mas não entra em nenhuma faixa do campo.')+'>'+num(r.sem)+' sem minuto</em>':'')+'</small></h3><div class=""campo"">'+campo()+'</div>';~~NL~~}~~NL~~function bloco2(){~~NL~~var r=resumo(est.fase,est.clube),cs=cartoesDe(est.fase,est.clube),m=D.cat.map(function(c){return{n:c.n,x:c.x,a:0,r:0}});~~NL~~cs.forEach(function(x){if(x.t==='a')m[x.m].a++;else m[x.m].r++});~~NL~~var l=m.map(function(x,i){return{i:i,n:x.n,x:x.x,a:x.a,r:x.r,tot:x.a+x.r}}).sort(function(x,y){return y.tot-x.tot||x.i-y.i});~~NL~~var max=Math.max.apply(null,l.map(function(x){return x.tot}).concat([1]));~~NL~~var h='<h3><span'+tp('Motivos dos cartões','A súmula traz '+D.meta.textos+' textos diferentes para o motivo dos cartões; eles foram agrupados em poucos tipos por palavras-chave (regras no arquivo de referência de motivos, revisado pelo autor). Nenhum texto da súmula aparece na tela.')+'>Motivos dos cartões</span><small>'+esc(rotulo())+'</small></h3>';~~NL~~l.forEach(function(x){~~NL~~h+='<div class=""mv""'+tp(x.n,plural(x.tot,'cartão','cartões')+' ('+pc(x.tot,r.tot)+' do recorte)',linhasTip([['Amarelos',num(x.a)],['Vermelhos',num(x.r)]]),'~'+x.x)+'><span class=""nm"">'+esc(x.n)+'</span><div class=""bb""><i class=""a"" style=""width:'+(100*x.a/max)+'%""></i><i class=""v"" style=""width:'+(100*x.r/max)+'%""></i></div><span class=""ct"">'+x.tot+'</span></div>';~~NL~~});~~NL~~return h+'<div class=""lg2""><span class=""a"">Amarelos</span><span class=""v"">Vermelhos</span></div>';~~NL~~}~~NL~~function bloco3(){~~NL~~var js=nosJogos(est.fase,null),m={};~~NL~~js.forEach(function(j){[j.m,j.v].forEach(function(c){var x=m[c]||(m[c]={c:c,a:0,r:0,v:0,s:0,n:0});x.n++})});~~NL~~cartoesDe(est.fase,null).forEach(function(x){var q=m[x.c];if(x.t==='a')q.a++;else{q.r++;if(x.t==='s')q.s++}});~~NL~~var l=Object.keys(m).map(function(k){return m[k]}).sort(function(x,y){return(y.a+y.r)-(x.a+x.r)||y.r-x.r||(nome(x.c)<nome(y.c)?-1:nome(x.c)>nome(y.c)?1:0)});~~NL~~var max=Math.max.apply(null,l.map(function(x){return x.a+x.r}).concat([1]));~~NL~~var h='<h3><span'+tp('Cartões por clube','Para cada clube, os cartões que recebeu (amarelos e vermelhos, jogadores e comissão técnica) nos jogos do recorte escolhido, do