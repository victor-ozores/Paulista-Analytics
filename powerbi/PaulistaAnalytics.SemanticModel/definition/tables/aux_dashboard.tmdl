	/// Pedaço 26 de 51 do código do dashboard (barra de navegação e as telas: HTML, CSS e JavaScript); as quebras de linha viram ~~NL~~. Oculta; gerada por scripts/14_gerar_medida_dashboard.py, não editar à mão.
	measure html_dashboard_cod_26 = "cares e os indicadores</b></span><span>Projeto independente, sem vínculo com a FPF · escudos são marcas dos clubes</span>';~~NL~~}~~NL~~function montarAjuda(){~~NL~~ajEl.innerHTML='<div class=""cx""><h2>Como ler esta tela</h2><div><h3>Passo a passo</h3><ol><li>Em cima: seis números dos gols (total, por jogo, de pênalti, de falta, contra e jogos sem gols).</li><li>O <b>campo</b> mostra quantos gols saíram em cada faixa de 15 minutos; o meio é o intervalo.</li><li>Os botões <b>Todas as fases</b>, <b>1ª fase</b> e <b>Mata-mata</b> mudam todos os blocos.</li><li>Clique em um clube na <b>artilharia</b> ou na lista de <b>gols pró e contra</b> para ver só os gols dele (os que fez e os que levou). Clique de novo, use <b>Limpar</b> ou a tecla Esc para soltar (Esc solta primeiro o clube e depois a fase).</li></ol></div><div><h3>Palavras que aparecem</h3><dl><dt>Gol contra</dt><dd>Gol feito por um jogador no próprio time. Vale para o adversário e não conta na artilharia.</dd><dt>Faixa de minuto</dt><dd>De 15 em 15 minutos. O acréscimo conta na faixa do tempo: 45+2 entra em 31-45 e 90+3 entra em 76-90+.</dd><dt>Pró e contra</dt><dd>Gols feitos e gols sofridos pelo clube.</dd><dt>Placar comum</dt><dd>O placar vale para os dois lados: 1 × 0 inclui vitória em casa e fora.</dd><dt>Disputa de pênaltis</dt><dd>As cobranças da disputa não são gols e não entram em nenhum número.</dd></dl></div><div class=""fe""><button data-act=""ajuda-fechar""'+tp('Fechar','Fecha este passo a passo. Também fecham as teclas Esc, Enter e espaço, ou um clique fora da janela.')+'>Entendi</button></div></div>';~~NL~~}~~NL~~function ajuda(abrir){~~NL~~if(abrir===undefined)abrir=!ajEl.classList.contains('on');~~NL~~if(abrir)esconderTip();~~NL~~ajEl.classList.toggle('on',abrir);~~NL~~}~~NL~~var PAIN=['p1','p2','p3','p4','p5'];~~NL~~function marcarRolagem(e){var w=e.parentNode;if(w&&w.classList)w.classList.toggle('mais',e.scrollHeight-e.scrollTop-e.clientHeight>2)}~~NL~~function ajustarRolagem(){var l=raiz.querySelectorAll('.rola');for(var i=0;i<l.length;i++)marcarRolagem(l[i])}~~NL~~function atualizar(){~~NL~~esconderTip();~~NL~~controles();cabecalho();~~NL~~EL.kpis.innerHTML=kpisHtml();~~NL~~EL.p1.innerHTML=bloco1();~~NL~~EL.p2.innerHTML=bloco2();~~NL~~EL.p3.innerHTML=bloco3();~~NL~~EL.p4.innerHTML=bloco4();~~NL~~EL.p5.innerHTML=bloco5();~~NL~~ajustarRolagem();~~NL~~}~~NL~~function ajustar(){~~NL~~var w=raiz.clientWidth,h=raiz.clientHeight;if(!w||!h)return;~~NL~~var k=Math.min(w/1920,h/1024);~~NL~~est.k=k;est.ox=Math.round((w-1920*k)/2);est.oy=Math.round((h-1024*k)/2);~~NL~~palco.style.transform='translate('+est.ox+'px,'+est.oy+'px) scale('+k+')';~~NL~~}~~NL~~window.addEventListener('resize',ajustar);~~NL~~if(window.ResizeObserver)new ResizeObserver(ajustar).observe(raiz);~~NL~~ajustar();setTimeout(ajustar,60);setTimeout(ajustar,400);~~NL~~function pontoPalco(ev){var r=raiz.getBoundingClientRect();return[(ev.clientX-r.left-est.ox)/est.k,(ev.clientY-r.top-est.oy)/est.k]}~~NL~~var tipT=null,tipAlvo=null;~~NL~~function mostrarTip(alvo,ev){~~NL~~var s=alvo.getAttribute('data-tip');if(!s)return;~~NL~~tipEl.innerHTML=tipHtml(s);~~NL~~tipEl.classList.add('on');~~NL~~posTip(ev,alvo);~~NL~~}~~NL~~function posTip(ev,alvo){~~NL~~var pt;~~NL~~if(ev&&typeof ev.clientX==='number')pt=pontoPalco(ev);~~NL~~else{var r=alvo.getBoundingClientRect(),q=raiz.getBoundingClientRect();pt=[(r.left+r.width/2-q.left-est.ox)/est.k,(r.top+r.height-q.top-est.oy)/est.k-8]}~~NL~~var w=tipEl.offsetWidth,h=tipEl.offsetHeight,x=pt[0]+22,y=pt[1]+26;~~NL~~if(x+w>1908)x=pt[0]-w-22;~~NL~~if(x<12)x=12;~~NL~~if(y+h>1012)y=pt[1]-h-18;~~NL~~if(y<12)y=12;~~NL~~tipEl.style.left=Math.round(x)+'px';tipEl.style.top=Math.round(y)+'px';~~NL~~}~~NL~~function esconderTip(){clearTimeout(tipT);tipAlvo=null;tipEl.classList.remove('on')}~~NL~~function acao(a,id,v){~~NL~~if(a==='fase'){~~NL~~if(!Object.prototype.hasOwnProperty.call(FS,v))return;~~NL~~est.fase=v;~~NL~~if(est.clube!==null&&!nosJogos(v,est.clube).length)est.clube=null;~~NL~~atualizar();~~NL~~}~~NL~~else if(a==='clube'){~~NL~~var n=Number(id);~~NL~~if(!CL[n]||!nosJogos(est.fase,n).length)return;~~NL~~est.clube=est.clube===n?null:n;~~NL~~atualizar();~~NL~~}~~NL~~else if(a==='limpar'){est.fase='t';est.clube=null;atualizar()}~~NL~~else if(a==='ajuda')ajuda(true);~~NL~~else if(a==='ajuda-fechar')ajuda(false);~~NL~~}~~NL~~raiz.addEventListener('click',function(ev){~~NL~~var alvo=ev.target,t=alvo.closest&&alvo.closest('[data-act]'),dentro=alvo.closest&&alvo.closest('.cx');~~NL~~if(ajEl.classList.contains('on')&&!dentro){ajuda(false);return}~~NL~~if(!t)return;~~NL~~acao(t.getAttribute('data-act'),t.getAttribute('data-id'),t.getAttribute('data-v'));~~NL~~esconderTip();~~NL~~raiz.focus({preventScroll:true});~~NL~~});~~NL~~raiz.addEventListener('mouseover',function(ev){~~NL~~var d=ev.target.closest&&ev.target.closest('[data-tip]');~~NL~~if(d!==tipAlvo){tipAlvo=d;clearTimeout(tipT);if(d){tipT=setTimeout(function(){mostrarTip(d,ev)},90)}else tipEl.classList.remove('on')}~~NL~~});~~NL~~raiz.addEventListener('mousemove',function(ev){if(tipAlvo&&tipEl.classList.contains('on'))posTip(ev,tipAlvo)});~~NL~~raiz.addEventListener('mouseleave',esconderTip);~~NL~~raiz.addEventListener('scroll',function(ev){var e=ev.target;if(e&&e.classList&&e.classList.contains('rola'))marcarRolagem(e)},true);~~NL~~raiz.addEventListener('focusin',function(ev){~~NL~~var d=ev.target.closest&&ev.target.closest('[data-tip]');~~NL~~if(d&&d!==tipAlvo&&ev.target!==raiz){tipAlvo=d;mostrarTip(d,null)}~~NL~~});~~NL~~raiz.addEventListener('focusout',esconderTip);~~NL~~raiz.addEventListener('touchstart',function(ev){~~NL~~var d=ev.target.closest&&ev.target.closest('[data-tip]');~~NL~~if(d&&d!==tipAlvo){tipAlvo=d;var tc=ev.touches&&ev.touches[0];mostrarTip(d,tc?{clientX:tc.clientX,clientY:tc.clientY}:null)}~~NL~~else if(!d)esconderTip();~~NL~~},{passive:true});~~NL~~function tecla(k,ctrl){~~NL~~if(k==='?'||(k==='h'&&!ctrl)){ajuda();return true}~~NL~~if(ajEl.classList.contains('on')){if(k==='Escape'||k==='Enter'||k===' '){ajuda(false);return true}return false}~~NL~~if(k==='Escape'||k==='Backspace'){~~NL~~if(est.clube!==null){est.clube=null;atualizar();return true}~~NL~~if(est.fase!=='t'){est.fase='t';atualizar();return true}~~NL~~}~~NL~~return false;~~NL~~}~~NL~~document.addEventListener('keydown',function(ev){~~NL~~if(!raiz.offsetParent)return;~~NL~~if(tecla(ev.key,ev.ctrlKey||ev.metaKey))ev.preventDefault();~~NL~~});~~NL~~var goT=null;~~NL~~function entrar(){~~NL~~clearTimeout(goT);~~NL~~raiz.classList.remove('go');~~NL~~void raiz.offsetWidth;~~NL~~raiz.classList.add('go');~~NL~~goT=setTimeout(function(){raiz.classList.remove('go')},1500);~~NL~~ajustar();~~NL~~atualizar();~~NL~~}~~NL~~montarAjuda();montarRodape();~~NL~~atualizar();~~NL~~if(window.PA&&window.PA.shell)window.PA.mods.gl={entrar:entrar};~~NL~~else entrar();~~NL~~if(/[?&]debug/.test(location.search))window.__glx={D:D,CL:CL,est:est,acao:acao,tecla:tecla,atualizar:atualizar,tipHtml:tipHtml,itensKpi:itensKpi,resumo:resumo,artilheiros:artilheiros,proContra:proContra,placares:placares,nosJogos:nosJogos,ordenar:ordenar};~~NL~~})();~~NL~~</script>~~NL~~</section><section class=""mod"" id=""mod-ds""><style>~~NL~~#dsx{--disp:""Arial Black"",""Segoe UI Black"",""Segoe UI"",Arial,sans-serif;--gold:#ffd166;--mut:#9aa6b8;--txt:#e6ecf5;--verm:#ff5470;--vermc:#ff8a95;--ciano:#4cc9f0;position:relative;width:100%;height:100%;min-height:320px;overflow:hidden;background:#05070a;color:#fff;font-family:""Segoe UI"",Arial,sans-serif;-webkit-user-select:none;user-select:none;outline:0}~~NL~~#dsx *{box-sizing:border-box}~~NL~~#dsx button{font:inherit;color:inherit;border:0;background:none;cursor:pointer;padding:0;text-align:inherit}~~NL~~#dsx button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}~~NL~~#dsx img{display:block}~~NL~~#dsx .palco{position:absolute;left:0;top:0;width:1920px;height:1024px;transform-origin:0 0;overflow:hidden;background:rad