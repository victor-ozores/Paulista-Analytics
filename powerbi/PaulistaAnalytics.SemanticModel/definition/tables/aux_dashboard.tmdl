pHtml(s){~~NL~~var sec=String(s).split('||'),h='<b>'+esc(sec[0])+'</b>';~~NL~~for(var i=1;i<sec.length;i++){~~NL~~var x=sec[i];if(!x)continue;~~NL~~if(x.charAt(0)==='@')h+='<div class=""tv"">'+x.slice(1).split('\n').map(function(l){var p=l.split('::');return'<div><span>'+esc(p[0])+'</span><em>'+esc(p[1]===undefined?'':p[1])+'</em></div>'}).join('')+'</div>';~~NL~~else if(x.charAt(0)==='~')h+='<small>'+esc(x.slice(1))+'</small>';~~NL~~else h+='<span>'+esc(x)+'</span>';~~NL~~}~~NL~~return h;~~NL~~}~~NL~~function nome(id){return CL[id].curto}~~NL~~function logo(id,t){~~NL~~var c=CL[id];~~NL~~if(LG[id])return'<img src=""'+LG[id]+'"" alt=""""'+(t?' style=""width:'+t+'px;height:'+t+'px""':'')+'>';~~NL~~return'<span class=""sg"" style=""background:'+c.cor+(t?';width:'+t+'px;height:'+t+'px':'')+'"">'+esc(c.sigla.charAt(0))+'</span>';~~NL~~}~~NL~~function zona(p){return p<=M.nq?'q':p>NR-M.nr?'r':''}~~NL~~function jogosDe(id){return D.mm.filter(function(j){return j.m===id||j.v===id}).sort(function(a,b){return a.n-b.n})}~~NL~~function placar(j){return j.gm+' × '+j.gv+(j.pm!==null?' (pênaltis '+j.pm+' a '+j.pv+')':'')}~~NL~~function caminho(id){~~NL~~var l=jogosDe(id).filter(function(j){return j.f<4}).map(function(j){~~NL~~var adv=j.m===id?j.v:j.m,venceu=j.w===id;~~NL~~return[FASE[j.f],(venceu?'passou':'caiu')+' contra '+nome(adv)+' ('+placar(j)+')'];~~NL~~});~~NL~~var fin=jogosDe(id).filter(function(j){return j.f===4});~~NL~~if(fin.length){var camp=M.camp===id;l.push(['Final',(camp?'campeão':'vice')+', '+(camp?M.fpts[0]+' a '+M.fpts[1]:M.fpts[1]+' a '+M.fpts[0])+' em pontos contra '+nome(camp?M.vice:M.camp)])}~~NL~~return l;~~NL~~}~~NL~~function fraseDesempate(g){~~NL~~return g.pares.map(function(p){~~NL~~var f=function(c,v){return c==='sg'?sinal(v):num(v)};~~NL~~var ant=p.iguais.length?', depois de empatar em '+nomeLista(p.iguais.map(function(c){return CRIT[c]}))+' ('+f(p.iguais[0],TAB[p.a][p.iguais[0]])+' a '+f(p.iguais[0],TAB[p.b][p.iguais[0]])+')':'';~~NL~~return nome(p.a)