/// Clubes: nome, sigla, cores e o escudo oficial reduzido em base64 (escudo_base64). Escudo e nomes: FPF; sigla e cor provisórias: ESPN (não oficial).
table dim_clube
	lineageTag: 77ec3b9c-34ed-54f2-9fc1-6be83159c553

