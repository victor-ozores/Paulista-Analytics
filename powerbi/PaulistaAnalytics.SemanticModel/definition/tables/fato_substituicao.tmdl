	column acrescimo
		dataType: int64
		formatString: 0
		lineageTag: 8b01a6b4-e5fa-5057-a7d0-d04245e0e9c8
		summarizeBy: none
		sourceColumn: acrescimo

	column minuto_total
		dataType: int64
		formatString: 0
		lineageTag: 8a11d125-08b6-53f0-b208-02b46efca42d
