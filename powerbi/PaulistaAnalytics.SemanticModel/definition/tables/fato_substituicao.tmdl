	column tipo
		dataType: string
		lineageTag: 29aa9b6a-75f3-5242-88a6-ec03c7bd50f5
		summarizeBy: none
		sourceColumn: tipo

	column id_atleta_saiu
		dataType: string
		lineageTag: c5f883d1-7c36-580f-b9d4-d8e9fc1e6a79
		summarizeBy: none
		sourceColumn: id_atleta_saiu

	column id_atleta_entrou
		dataType: string
		lineageTag: f198bd74-2292-5076-93c8-cba191b5982a
		summarizeBy: none
		sourceColumn: id_atleta_entrou

	column numero_saiu
		dataType: int64
		formatString: 0
		lineageTag: b513d346-a88c-5079-baec-f062307237fc
		summarizeBy: none
		sourceColumn: numero_saiu

	column numero_entrou
		dataType: int64
		formatString: 0
		lineageTag: 686ea3e6-fe7a-5d0b-b833-569d67143b07
