/// Substituições de cada jogo (regulares e por concussão): quem saiu, quem entrou, período e minuto. Fonte: súmulas da FPF.
table fato_substituicao
	lineageTag: 5e579d03-c07c-52fb-95e7-e5ebc13594f9

	column id_substituicao
		dataType: string
		lineageTag: 2224ee10-0fda-57d9-9e3b-4ff1b829fc15
		summarizeBy: none
		sourceColumn: id_substituicao

	column id_partida
		dataType: int64
		formatString: 0
		lineageTag: c4b91a96-42aa-5169-86b2-a9ceffa16f4f
		summarizeBy: none
		sourceColumn: id_partida

	column id_clube
		dataType: int64
		formatString: 0
		lineageTag: 6291019f-9950-541a-950a-93fbdf070949
